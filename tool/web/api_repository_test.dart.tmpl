  test(
    'api-client-contract read scheduler shares three active slots across six GET query attachment reads in FIFO order',
    () async {
      final http = _HttpMock();
      final client = _mockClient(http);
      addTearDown(client.close);
      final started = List.generate(6, (_) => Completer<void>());
      final gates = List.generate(6, (_) => Completer<void>());
      final order = <int>[];
      var active = 0;
      var maximum = 0;
      Future<void> enter(ApiRequest request) async {
        final id = int.parse(request.path.split('/').last);
        order.add(id);
        active++;
        if (active > maximum) maximum = active;
        started[id].complete();
        await gates[id].future;
        active--;
      }

      http.handler = (request) async {
        await enter(request);
        return http.ok({'answer': request.path});
      };
      http.attachmentHandler = (request) async {
        await enter(request);
        return ApiBinaryResponse(
          200,
          Uint8List(0),
          headers: {'x-flclash-revision': '17'},
        );
      };
      final reads = <Future<Object?>>[
        client.read('/api/v1/refresh/0'),
        client.query('/api/v1/refresh/1', {'expectedRevision': '17'}),
        client.readAttachment('/api/v1/refresh/2'),
        client.read('/api/v1/refresh/3'),
        client.query('/api/v1/refresh/4', {'expectedRevision': '17'}),
        client.readAttachment('/api/v1/refresh/5'),
      ];
      await Future.wait(started.take(3).map((gate) => gate.future));
      expect(order, [0, 1, 2]);
      gates[0].complete();
      await started[3].future;
      gates[1].complete();
      await started[4].future;
      gates[2].complete();
      await started[5].future;
      expect(order, [0, 1, 2, 3, 4, 5]);
      for (final gate in gates.skip(3)) {
        gate.complete();
      }
      await Future.wait(reads);
      expect(maximum, 3);
    },
  );

