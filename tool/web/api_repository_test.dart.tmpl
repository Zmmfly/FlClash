      if (command == 'delete') {
        final urls = body['urls'] as List;
        icons.removeWhere((item) => urls.contains(item['url']));
        return {'deletedUrls': urls};
      }
      final row = {'url': body['url'], 'lastAccessed': '1700000000000'};
      icons.removeWhere((item) => item['url'] == body['url']);
      icons.add(row);
      return row;
    }
    if (resource == 'ip-quality-cache') {
      final quality = Map<String, Object?>.from(body['quality'] as Map);
      final row = {
        'ip': quality['ip'],
        'quality': quality,
        'checkedAt': '2026-01-02T03:04:05.000Z',
      };
      qualities.removeWhere((item) => item['ip'] == row['ip']);
      qualities.add(row);
      return row;
    }
    final rows = resource == 'profiles'
        ? profiles
        : resource == 'rules'
        ? rules
        : catalogs.putIfAbsent(resource, () => []);
    final singular = switch (resource) {
      'profiles' => 'profile',
      'rules' => 'rule',
      'proxy-groups' => 'group',
      'custom-proxies' => 'proxy',
      'scripts' => 'script',
      'clash-providers' => 'provider',
      'mitm-modules' => 'module',
      'icon-sets' => 'iconSet',
      _ => throw StateError('Unexpected route $path'),
    };
    final plural = switch (resource) {
      'custom-proxies' => 'proxies',
      'proxy-groups' => 'groups',
      'clash-providers' => 'providers',
      'mitm-modules' => 'modules',
      'icon-sets' => 'iconSets',
      _ => resource,
    };
    Map<String, Object?> make(Map<String, Object?> input, [String? id]) => {
      ...switch (resource) {
        'profiles' => _profile(id ?? allocateId()),
        'rules' => _rule(id ?? allocateId()),
        'scripts' => {'lastUpdateTime': '2026-01-02T03:04:05.000Z', 'order': 0},
