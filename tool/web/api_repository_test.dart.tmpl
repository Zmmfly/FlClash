class _WrappedContentMutation implements ApiCanonicalProjectionCarrier {
  const _WrappedContentMutation({
    required this.profile,
    required this.script,
    required this.ruleProvider,
    required this.mitmModule,
  });

  final Profile profile;
  final Script script;
  final ClashProvider ruleProvider;
  final MitmModule mitmModule;

  @override
  Iterable<ApiCanonicalProjection> get canonicalProjections => [
    ApiCanonicalProjection(
      ApiIdentity.profile,
      profile,
      path: const ['profile'],
    ),
    ApiCanonicalProjection(ApiIdentity.script, script, path: const ['script']),
    ApiCanonicalProjection(
      ApiIdentity.clashProvider,
      ruleProvider,
      path: const ['ruleProvider'],
    ),
    ApiCanonicalProjection(
      ApiIdentity.mitmModule,
      mitmModule,
      path: const ['mitmModule'],
    ),
  ];
}

class _ProjectionCarrier implements ApiCanonicalProjectionCarrier {
  const _ProjectionCarrier(this.canonicalProjections);

  @override
  final List<ApiCanonicalProjection> canonicalProjections;
}

_WrappedContentMutation _decodeWrappedMutation(
  WebApiRepository repository,
  Object? value,
) {
  final data = apiObject(value);
  return _WrappedContentMutation(
    profile: repository.codec.profile(data['profile']),
    script: repository.codec.script(data['script']),
    ruleProvider: repository.codec.clashProvider(data['ruleProvider']),
    mitmModule: repository.codec.mitmModule(data['mitmModule']),
  );
}

