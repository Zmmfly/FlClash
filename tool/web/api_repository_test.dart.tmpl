  test(
    'api-client-contract an edit captured before our own unrelated commit still applies',
    () async {
      Future<void> commitRule(String content) async {
        final rule = (await repository.rules().get()).first;
        await repository.saveRule(
          rule.copyWith(content: content),
          editVersion: repository.captureEditVersion(ApiIdentity.rule, rule),
        );
      }

      final conflict = throwsA(
        isA<WebApiException>().having(
          (e) => e.code,
          'code',
          'revision_conflict',
        ),
      );
      final profile = (await repository.profiles().get()).single;
      final form = repository.captureEditVersion(ApiIdentity.profile, profile);
      final blank = repository.captureCreateVersion(ApiIdentity.rule);
      await commitRule('own-first.test');
      await repository.saveProfile(
        profile.copyWith(label: 'kept draft'),
        editVersion: form,
      );
      expect(server.profiles.single['label'], 'kept draft');
      await repository.saveRule(
        Rule(id: allocateWebDraftId(), content: 'kept-new.test'),
        editVersion: blank,
      );
      expect(server.rules, hasLength(2));

      final current = (await repository.profiles().get()).single;
      final reused = repository.captureEditVersion(
        ApiIdentity.profile,
        current,
      );
      await repository.saveProfile(
        current.copyWith(label: 'first'),
        editVersion: reused,
      );
      await expectLater(
        repository.saveProfile(
          current.copyWith(label: 'second'),
          editVersion: reused,
        ),
        conflict,
      );
      expect(server.profiles.single['label'], 'first');

      final latest = (await repository.profiles().get()).single;
      final overtaken = repository.captureEditVersion(
        ApiIdentity.profile,
        latest,
      );
      server.advance();
      await repository.handleCommitEvent({'revision': server.revision});
      await commitRule('own-second.test');
      await expectLater(
        repository.saveProfile(
          latest.copyWith(label: 'after another tab'),
          editVersion: overtaken,
        ),
