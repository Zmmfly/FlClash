  test(
    'api-client-contract source authorization unknown-result recovery uses its isolated ledger after reload',
    () async {
      final http = _HttpMock();
      final journal = MemoryApiOperationJournal();
      final first = _mockClient(http, journal: journal);
      addTearDown(first.close);
      await first.read('/api/v1/meta');
      http.handler = (_) async =>
          throw StateError('source authorization receipt lost');
      await expectLater(
        first.command('/api/v1/sources:authorize', {
          'preparationId': 'opaque-prepared-source',
          'urlDigest': 'synthetic-digest',
          'intent': 'authorize-server-private-source',
        }, expectedRevision: '17'),
        throwsA(isA<WebApiUnknownCommitException>()),
      );
      final operationId = first.pendingOperation!.operationId;
      final restored = _mockClient(http, journal: journal);
      addTearDown(restored.close);
      http.handler = (request) async {
        expect(request.path, '/api/v1/source-operations/$operationId');
        return http.ok({
          'authorizationToken': 'synthetic-source-token',
        }, id: operationId);
      };
      final receipt = await restored.recoverOperation(operationId);
      restored.completeOperation(receipt);
      expect(restored.pendingOperation, isNull);
      expect(
        jsonEncode(journal.read()?.toJournal()),
        isNot(contains('synthetic-source-token')),
      );
      http.handler = (_) async =>
          throw StateError('second lost source request');
      await expectLater(
        restored.command('/api/v1/sources:authorize', {
          'intent': 'authorize-server-private-source',
        }, expectedRevision: '17'),
        throwsA(isA<WebApiUnknownCommitException>()),
      );
      final missing = restored.pendingOperation!.operationId;
      http.handler = (request) async {
        expect(request.path, '/api/v1/source-operations/$missing:resolve');
        expect(jsonDecode(request.body!), {'intent': 'resolve-unknown-result'});
        return ApiResponse(
          409,
          jsonEncode({
            'revision': '17',
            'error': {
              'code': 'operation_not_committed',
              'message': 'tombstoned',
              'details': {'state': 'not_committed'},
            },
          }),
        );
      };
      await expectLater(
        restored.resolveOperation(missing),
        throwsA(
          isA<WebApiException>().having(
            (e) => e.code,
            'code',
            'operation_not_committed',
          ),
        ),
      );
      expect(restored.pendingOperation, isNull);
    },
  );
