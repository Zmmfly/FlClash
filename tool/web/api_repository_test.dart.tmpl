      rows.removeWhere((row) => ids.contains(row['id']));
      if (resource == 'rules') {
        for (final idsForProfile in disabled.values) {
          idsForProfile.removeWhere(ids.contains);
        }
      }
      return {'deletedIds': ids};
    }
    if (command == 'reorder') {
      final ids = body['ids'] as List;
      final owned = resource == 'rules' || resource == 'proxy-groups';
      final current = [
        for (final row in rows)
          if (!owned || row['profileId'] == body['profileId']) row,
      ];
      if (ids.length != current.length ||
          ids.toSet().length != ids.length ||
          ids.any((id) => !current.any((row) => row['id'] == id))) {
        return _error(409, 'invalid_order');
      }
      final ordered = [
        for (final id in ids) current.singleWhere((row) => row['id'] == id),
      ];
      rows.removeWhere(current.contains);
      rows.addAll(ordered);
      return ordered;
    }
    if (command == 'replace') {
      final inputs = body[plural] as List;
      final owner = body['profileId'];
      final result = <Map<String, Object?>>[];
      for (final value in inputs) {
        final input = Map<String, Object?>.from(value as Map);
        final id = input.remove('id') as String?;
        final rejected = _validateInput(resource, input);
        if (rejected != null) return rejected;
        if (id != null &&
            !rows.any(
              (row) =>
                  row['id'] == id &&
                  (resource != 'rules' && resource != 'proxy-groups' ||
                      row['profileId'] == owner),
            )) {
          return _error(409, 'wrong_owner');
        }
        final row = make(input, id ?? allocateId());
        if (resource == 'rules') row['profileId'] = owner;
        result.add(row);
      }
      rows.removeWhere(
        (row) =>
            resource != 'rules' && resource != 'proxy-groups' ||
            row['profileId'] == owner,
      );
      rows.addAll(result);
      return result;
    }
    if (command == 'reset-dialers') {
      final row = rows.singleWhere((row) => row['id'] == body['id']);
      row.remove('overridesRawDocument');
      row['overrides'] = <String, Object?>{};
      return row;
    }
    if (command == 'rename') {
      final row = rows.singleWhere((row) => row['id'] == body['id']);
      row['label'] = body['label'];
      return row;
    }
    final input = Map<String, Object?>.from(body[singular] as Map);
    final rejected = _validateInput(resource, input);
    if (rejected != null) return rejected;
    expect(input.containsKey('id'), isFalse);
    final id = command == 'create' ? allocateId() : body['id'] as String;
    if (command == 'update' && !rows.any((row) => row['id'] == id)) {
      return _error(404, 'not_found');
    }
    final row = command == 'update'
        ? {...rows.singleWhere((item) => item['id'] == id), ...input, 'id': id}
        : make(input, id);
    rows.removeWhere((item) => item['id'] == id);
    rows.add(row);
    return row;
  }

