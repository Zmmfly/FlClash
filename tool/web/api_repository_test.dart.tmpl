  test(
    'api-client-contract synchronously registered write intent fences an immediate auto-apply read before HTTP starts',
    () async {
      await repository.initialize();
      final version = repository.captureCreateVersion(ApiIdentity.rule);
      final draft = Rule(id: allocateWebDraftId(), content: 'queued intent');
      final preflight = Completer<void>();
      final started = server.postStarted = Completer<void>();
      final receiptGate = server.replyGate = Completer<void>();
      final write = repository.runIntent(() async {
        await preflight.future;
        return repository.saveRule(draft, editVersion: version);
      });
      var appliedSnapshot = false;
      final readForApply = repository
          .readExternal('/api/v1/rules?scope=global')
          .then((receipt) {
            appliedSnapshot = true;
            return receipt;
          });
      expect(appliedSnapshot, isFalse);
      preflight.complete();
      await started.future;
      await repository.handleCommitEvent({
        'revision': server.revision,
        'operationId': repository.pendingOperation!.operationId,
      });
      expect(appliedSnapshot, isFalse);
      receiptGate.complete();
      await write;
      final snapshot = await readForApply;
      expect(appliedSnapshot, isTrue);
      expect(
        (snapshot.data as List).any(
          (value) => (value as Map)['content'] == 'queued intent',
        ),
        isTrue,
      );
    },
  );

