      expect((await reload.profiles().get()).single.scriptId, loadedScript.id);
      expect(
        () =>
            repository.identities.decode(ApiIdentity.profile, 9007199254740992),
        throwsA(isA<WebApiProtocolException>()),
      );
      expect(
        () => repository.identities.decode(
          ApiIdentity.profile,
          '9223372036854775808',
        ),
        throwsA(isA<WebApiProtocolException>()),
      );
