        readForApply,
        throwsA(isA<WebApiPendingOperationException>()),
      );
      preflight.complete();
      await rejectedWrite;
      await rejectedRead;
      await repository.recoverOperation(
        repository.pendingOperation!.operationId,
      );
      final snapshot = await repository.readExternal(
        '/api/v1/rules?scope=global',
      );
      expect(
        (snapshot.data as List).any(
