    requestedAttachmentLimit = maxBytes;
    final response =
        nextAttachment ??
        ApiBinaryResponse(
          200,
          Uint8List.fromList([0, 255, 128, 1, 10]),
          headers: {
            'X-FlClash-Revision': revision,
            'Content-Type': 'application/octet-stream',
            'Content-Length': '5',
            'Content-Disposition': 'attachment; filename="profile.bin"',
          },
        );
    nextAttachment = null;
    attachmentStarted?.complete();
    attachmentStarted = null;
    final gate = attachmentGate;
    attachmentGate = null;
    if (gate != null) await gate.future;
    return response;
  }

  @override
  void close() {}
}

