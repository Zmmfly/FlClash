final _png = base64Decode(
  'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==',
);
const _url = 'https://icons.example.test/icon.png';

Map<String, Object?> _release() => {
  'provider': 'github',
  'repository': 'chen08209/FlClash',
  'tagName': 'v9.2.3',
  'version': '9.2.3',
  'name': 'Release',
  'body': 'Plain notes https://untrusted.test/never-open',
  'publishedAt': '2026-01-01T00:00:00Z',
  'checkedAt': '2026-01-02T00:00:00Z',
  'releaseUrl': 'https://github.com/chen08209/FlClash/releases/tag/v9.2.3',
  'updatePolicy': 'server-image',
  'assets': [
    {
      'name': 'FlClash-9.2.3-android.apk',
      'size': 123,
      'url':
          'https://github.com/chen08209/FlClash/releases/download/v9.2.3/FlClash-9.2.3-android.apk',
    },
  ],
};

Map<String, Object?> _image(String url, [Uint8List? bytes]) => {
  'bytes': base64Encode(bytes ?? _png),
  'size': (bytes ?? _png).length,
  'mediaType': 'image/png',
  'sha256': crypto.sha256.convert(bytes ?? _png).toString(),
  'sourceId': utilitySourceId(url),
};

ApiResponse _reply(
  Object? data, {
  String revision = '0',
  String? operationId,
}) => ApiResponse(
  200,
  jsonEncode({'revision': revision, 'data': data, 'operationId': ?operationId}),
);

ApiResponse _error(String code, {int status = 400, String revision = '0'}) =>
    ApiResponse(
      status,
      jsonEncode({
        'revision': revision,
        'error': {'code': code, 'message': code},
      }),
    );

class _Server {
  var cacheRevision = 0;
  var configurationRevision = '0';
  String qualityCheckedAt = '2026-01-02T00:00:00Z';
  final preparations = <Map<String, Object?>>[];
  final authorizations = <Map<String, Object?>>[];
  final receipts = <String, ApiResponse>{};
  final registered = <String>{_url};
  Map<String, Object?> release = _release();
  Completer<ApiResponse>? imageReply;
  Completer<void>? registerGate;
  bool dropRegisterResponse = false;
  bool failImage = false;
  int imageFetches = 0;

  Future<ApiResponse> send(ApiRequest request) async {
    final data = request.body == null
        ? <String, Object?>{}
        : Map<String, Object?>.from(jsonDecode(request.body!) as Map);
    if (request.path == '/api/v1/meta') {
      return _reply({
        'storeId': 'utility-fixture',
        'schemaVersion': 1,
        'revision': configurationRevision,
      }, revision: configurationRevision);
    }
    if (request.path.startsWith('/api/v1/icon-cache?')) {
      return _reply([], revision: '$cacheRevision');
    }
    if (request.path.startsWith('/api/v1/cache-operations/')) {
      return receipts[request.path.split('/').last] ??
          _error('not_found', status: 404);
    }
    if (request.path == '/api/v1/app/release') return _reply(release);
    if (request.path == '/api/v1/ip-quality:lookup') {
      return _reply({
        'ip': data['ip'],
        'checkedAt': qualityCheckedAt,
        'quality': {
          'ip': data['ip'],
          'source': 'ipQuery',
          'type': 'hosting',
          'organization': 'Fixture',
          'asn': 123,
          'isProxy': true,
          'isVpn': false,
          'isTor': false,
          'isAbuser': false,
        },
      });
    }
    if (request.path == '/api/v1/sources:prepare') {
      final preparation = <String, Object?>{
        'preparationId':
            'utility-preparation-${preparations.length.toString().padLeft(24, '0')}',
        'urlDigest': List.filled(64, 'a').join(),
        'purpose': 'icon-image',
        'key': data['key'],
        'networkView': 'server',
        'scheme': 'http',
        'host': 'lan.test',
        'port': 80,
        'addresses': ['10.20.30.40'],
        'requiresPrivateNetworkConfirmation': true,
        'expiresAt': DateTime.now()
            .toUtc()
            .add(const Duration(minutes: 5))
            .toIso8601String(),
      };
      preparations.add(preparation);
      return _reply(preparation, revision: configurationRevision);
    }
    if (request.path == '/api/v1/sources:authorize') {
      authorizations.add(data);
      if (data['expectedRevision'] != configurationRevision) {
        return _error(
          'revision_conflict',
          status: 409,
          revision: configurationRevision,
        );
      }
      if (data['preparationId'] != preparations.last['preparationId'] ||
          data['urlDigest'] != preparations.last['urlDigest'] ||
          data['intent'] != 'authorize-server-private-source') {
        return _error(
          'source_preparation_invalid',
          status: 409,
          revision: configurationRevision,
        );
      }
      return _reply(
        {
          'authorizationId': 'utility-image-grant-fixture-00001',
          'expiresAt': DateTime.now()
              .toUtc()
              .add(const Duration(hours: 1))
              .toIso8601String(),
        },
        revision: configurationRevision,
        operationId: data['operationId'] as String,
      );
    }
    if (request.path == '/api/v1/icon-images:load') {
      imageFetches++;
      if (imageReply != null) return imageReply!.future;
      if (failImage) return _error('invalid_icon_image', status: 422);
      final url = data['url'] as String;
      if (url.contains('lan.test') &&
          data['authorizationId'] != 'utility-image-grant-fixture-00001') {
        return _error('source_authorization_required', status: 403);
      }
      return _reply(_image(url), revision: configurationRevision);
    }
    if (request.path == '/api/v1/icon-images:register') {
      if (registerGate != null) await registerGate!.future;
      final operation = data['operationId'] as String;
      if (receipts[operation] case final receipt?) return receipt;
      if (data['expectedRevision'] != '$cacheRevision') {
        return _error(
          'revision_conflict',
          status: 409,
          revision: '$cacheRevision',
        );
      }
      if (data['intent'] != 'preview-icon') {
        return _error('icon_preview_intent_required');
      }
      final url = data['url'] as String;
      registered.add(url);
      cacheRevision++;
      final receipt = _reply(
        {'url': url, 'sourceId': utilitySourceId(url), 'lastAccessed': '100'},
        revision: '$cacheRevision',
        operationId: operation,
      );
      receipts[operation] = receipt;
      if (dropRegisterResponse) {
        dropRegisterResponse = false;
        throw TimeoutException('response lost');
      }
      return receipt;
    }
    throw StateError(
      'Unexpected or generic relay request: ${request.method} ${request.path}',
    );
  }
}

class _Transport implements ApiTransport {
  _Transport(this.server);
  final _Server server;
  final requests = <ApiRequest>[];
  @override
  Future<ApiResponse> send(ApiRequest request) {
    requests.add(request);
    return server.send(request);
  }

  @override
  void close() {}
}

({WebApiRepository repository, WebUtilities utility, _Transport transport})
_fixture([_Server? server]) {
  final transport = _Transport(server ?? _Server());
  final repository = WebApiRepository(
    transport: transport,
    journal: MemoryApiOperationJournal(),
  );
  final utility = WebUtilities(repository);
  addTearDown(() async {
    await utility.close();
    await repository.close();
  });
  return (repository: repository, utility: utility, transport: transport);
}

