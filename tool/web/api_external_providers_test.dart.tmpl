import 'dart:async';
import 'dart:convert';
import 'dart:typed_data';

import 'package:crypto/crypto.dart' as crypto;
import 'package:fl_clash/models/models.dart';
import 'package:fl_clash/web_api/index.dart';
import 'package:fl_clash/web_runtime/runtime.dart';
import 'package:fl_clash/web_workflows/external_providers.dart';
import 'package:flutter_test/flutter_test.dart';

const _profileId = '9223372036854775807';
const _providerId = '9223372036854775807';
const _opaqueId =
    '115792089237316195423570985008687907853269984665640564039457584007913129639935';
const _opaqueRoot = '/api/v1/runtime/provider-sources/$_opaqueId';
final _version = List.filled(64, 'a').join();

ApiResponse _answer(String revision, Object? data, {String? operationId}) =>
    ApiResponse(
      200,
      jsonEncode({
        'revision': revision,
        'data': data,
        'operationId': ?operationId,
      }),
    );

class _ProviderTransport implements ApiTransport {
  final requests = <ApiRequest>[];
  final receipts = <String, ApiResponse>{};
  final operations = <String, Map<String, Object?>>{};
  final accepted = Completer<void>();
  String revision = '1';
  String storeId = 'external-provider-fixture';
  String sourceVersion = _version;
  String sourcePhase = 'ready';
  Uint8List opaqueBytes = Uint8List.fromList(
    utf8.encode('payload:\n  - example.test\n'),
  );
  Uint8List profileBytes = Uint8List.fromList(utf8.encode('proxies: []\n'));
  Uint8List ruleBytes = Uint8List.fromList(
    utf8.encode('payload:\n  - example.test\n'),
  );
  bool mrs = false;
  bool privateSource = false;
  bool loseNextMutation = false;
  int runtimeReads = 0;
  int pendingReads = 0;
  String terminalPhase = 'applied';
  String? rejectRuntimeCode;
  Completer<void>? runtimeGate;
  Map<String, Object?> sourcePatch = {};
  Map<String, Object?> headPatch = {};
  Map<String, Object?> contentPatch = {};
  Map<String, Object?> previewPatch = {};
  Map<String, Object?> resultPatch = {};
  Map<String, Object?> acceptedPatch = {};
  Map<String, Object?> operationPatch = {};
  Map<String, Object?> managedMutationPatch = {};
  Object? sourceRows;

  Map<String, Object?> runtimeSnapshotPatch = {};
  Object? runtimeRows;
  String? runtimeInventoryError;

  List<Map<String, Object?>> runtimeProviders() => [
    {
      'name': 'Managed profile',
      'type': 'Proxy',
      'vehicleType': 'File',
      'count': 5,
      'updatedAt': '2026-11-15T00:00:00Z',
      'subscriptionInfo': {
        'upload': '9007199254740993',
        'download': '123',
        'total': _profileId,
        'expire': '1700000000',
      },
      'binding': {'kind': 'profile', 'id': _profileId},
    },
    {
      'name': 'Managed rule set',
      'type': 'Rule',
      'vehicleType': 'File',
      'count': 2,
      'updatedAt': null,
      'subscriptionInfo': null,
      'binding': {'kind': 'rule-provider', 'id': _providerId},
    },
    {
      'name': 'HTTP source',
      'type': 'Rule',
      'vehicleType': 'File',
      'count': 3,
      'updatedAt': null,
      'subscriptionInfo': null,
      'binding': {
        'kind': 'external-provider',
        'id': _opaqueId,
        'profileId': _profileId,
        'purpose': 'rule-providers',
        'sourceVersion': _version,
      },
    },
  ];

  Map<String, Object?> profile() => {
    'id': _profileId,
    'type': 'url',
    'label': 'Managed profile',
    'url': 'https://profile.example.test/source',
    'autoUpdateDurationMillis': 3600000,
    'autoUpdate': true,
    'selectedMap': <String, String>{},
    'unfoldSet': <String>[],
    'extendType': 'standard',
  };

  Map<String, Object?> provider() => {
    'id': _providerId,
    'label': 'Managed rule set',
    'url': 'https://rules.example.test/source',
    'behavior': 'domain',
    'format': mrs ? 'mrs' : 'yaml',
  };

  Map<String, Object?> source() => {
    'id': _opaqueId,
    'profileId': _profileId,
    'name': 'HTTP source',
    'purpose': 'rule-providers',
    'sourceVersion': sourceVersion,
    'phase': sourcePhase,
    ...sourcePatch,
  };

  Map<String, Object?> head() => {
    'source': source(),
    'prepared': sourcePhase == 'ready',
    'mediaType': mrs ? 'application/octet-stream' : 'text/plain; charset=utf-8',
    'size': sourcePhase == 'ready' ? opaqueBytes.length : 0,
    'sha256': sourcePhase == 'ready'
        ? crypto.sha256.convert(opaqueBytes).toString()
        : '',
    ...headPatch,
  };

  Map<String, Object?> summary(String kind, Uint8List bytes) => {
    'key': {'kind': kind, 'id': kind == 'profile' ? _profileId : _providerId},
    'mediaType': kind == 'profile'
        ? 'application/yaml'
        : mrs
        ? 'application/octet-stream'
        : 'application/yaml',
    'size': bytes.length,
    'sha256': crypto.sha256.convert(bytes).toString(),
  };

  ApiResponse _error(String code, {int status = 409}) => ApiResponse(
    status,
    jsonEncode({
      'revision': revision,
      'error': {'code': code, 'message': 'Synthetic provider rejection'},
    }),
  );

  ApiResponse _commit(
    Map<String, Object?> body,
    Object? data, {
    bool increment = true,
  }) {
    if (body['expectedRevision'] != revision) {
      return _error('revision_conflict');
    }
    if (increment) revision = (BigInt.parse(revision) + BigInt.one).toString();
    final operationId = body['operationId'] as String;
    final receipt = _answer(revision, data, operationId: operationId);
    receipts[operationId] = receipt;
    if (loseNextMutation) {
      loseNextMutation = false;
      throw StateError('Synthetic lost response after durable acceptance');
    }
    return receipt;
  }

  @override
  Future<ApiResponse> send(ApiRequest request) async {
    requests.add(request);
    final path = request.path;
    if (path == '/api/v1/meta') {
      return _answer(revision, {
        'storeId': storeId,
        'schemaVersion': 1,
        'revision': revision,
      });
    }
    if (request.method == 'GET' && Uri.parse(path).path == '/api/v1/profiles') {
      return _answer(revision, [profile()]);
    }
    if (path == '/api/v1/clash-providers' && request.method == 'GET') {
      return _answer(revision, [provider()]);
    }
    if (path == '/api/v1/runtime/external-providers') {
      if (runtimeInventoryError case final error?) return _error(error);
      return _answer(revision, {
        'runtimeGeneration': '7',
        'actualConfig': 'candidate',
        'providers': runtimeRows ?? runtimeProviders(),
        ...runtimeSnapshotPatch,
      });
    }
    if (path.startsWith('/api/v1/runtime/provider-sources?profileId=')) {
      return _answer(revision, sourceRows ?? [source()]);
    }
    if (path == _opaqueRoot) return _answer(revision, head());
    if (path == '$_opaqueRoot/content') {
      if (sourcePhase != 'ready') return _error('provider_source_unavailable');
      return _answer(revision, {
        ...head(),
        'bytes': base64Encode(opaqueBytes),
        ...contentPatch,
      });
    }
    if (path == '$_opaqueRoot/preview') {
      String text;
      try {
        text = mrs ? 'example.test\n' : utf8.decode(opaqueBytes);
      } on FormatException {
        return _error('invalid_provider_content', status: 422);
      }
      return _answer(revision, {
        'sourceVersion': sourceVersion,
        'format': mrs ? 'mrs' : 'text',
        'text': text,
        'readOnly': mrs,
        'size': opaqueBytes.length,
        'sha256': crypto.sha256.convert(opaqueBytes).toString(),
        ...previewPatch,
      });
    }
    if (path == '/api/v1/rule-providers/$_providerId/preview') {
      return _answer(revision, {
        'id': _providerId,
        'behavior': 'domain',
        'format': mrs ? 'mrs' : 'yaml',
        'text': mrs ? 'example.test\n' : utf8.decode(ruleBytes),
      });
    }
    if (path == '/api/v1/content/profile/$_profileId' ||
        path == '/api/v1/content/rule-provider/$_providerId') {
      final kind = path.contains('/content/profile/')
          ? 'profile'
          : 'rule-provider';
      final bytes = kind == 'profile' ? profileBytes : ruleBytes;
      return _answer(revision, {
        ...summary(kind, bytes),
        'bytes': base64Encode(bytes),
        'encrypted': false,
      });
    }
    if (path.startsWith('/api/v1/runtime/operations/')) {
      final id = path.split('/').last;
      final operation = operations[id];
      if (operation == null) throw StateError('Unknown runtime operation $id');
      runtimeReads++;
      if (runtimeGate case final gate?) await gate.future;
      if (runtimeReads <= pendingReads) {
        return _answer(revision, {...operation, 'phase': 'applying'});
      }
      return _answer(revision, {
        ...operation,
        'phase': terminalPhase,
        if (terminalPhase == 'applied')
          'result': {
            'id': _opaqueId,
            'sourceVersion': sourceVersion,
            'prepared': true,
            'requiresApply': true,
            ...resultPatch,
          },
        if (terminalPhase != 'applied')
          'error': {
            'code': 'effect_unknown',
            'message': 'Synthetic terminal failure',
          },
        ...operationPatch,
      });
    }
    if (path.startsWith('/api/v1/operations/')) {
      return receipts[path.split('/').last] ??
          _error('operation_not_found', status: 404);
    }
    if (request.method != 'POST') {
      throw StateError('Unexpected provider read $path');
    }
    final body = jsonDecode(request.body!) as Map<String, Object?>;
    if (path == '/api/v1/sources:prepare') {
      if (body['expectedRevision'] != revision) {
        return _error('source_revision_conflict');
      }
      return _answer(revision, {
        'preparationId': List.filled(43, 'P').join(),
        'urlDigest': List.filled(64, 'b').join(),
        'purpose': body['purpose'],
        'key': body['key'],
        'expiresAt': DateTime.now()
            .toUtc()
            .add(const Duration(minutes: 4))
            .toIso8601String(),
        'networkView': 'server',
        'scheme': 'https',
        'host': 'rules.example.test',
        'port': 443,
        'addresses': [privateSource ? '10.0.0.8' : '192.0.2.8'],
        'requiresPrivateNetworkConfirmation': privateSource,
      });
    }
    if (path == '/api/v1/sources:authorize') {
      return _commit(body, {
        'authorizationId': List.filled(43, 'G').join(),
        'expiresAt': DateTime.now()
            .toUtc()
            .add(const Duration(minutes: 3))
            .toIso8601String(),
      }, increment: false);
    }
    if (path == '/api/v1/content:write' || path == '/api/v1/content:refresh') {
      final kind = (body['key'] as Map)['kind'] as String;
      final bytes = path.endsWith(':write')
          ? base64Decode(body['bytes'] as String)
          : kind == 'profile'
          ? profileBytes
          : ruleBytes;
      if (kind == 'profile') {
        profileBytes = bytes;
      } else {
        ruleBytes = bytes;
      }
      return _commit(body, {
        'content': summary(kind, bytes),
        if (kind == 'profile')
          'profile': profile()
        else
          'ruleProvider': provider(),
        ...managedMutationPatch,
      });
    }
    final action = switch (path) {
      '$_opaqueRoot:write' => 'write-provider-source',
      '$_opaqueRoot:sideload' => 'sideload-provider-source',
      '/api/v1/runtime/provider-sources:refresh' => 'refresh-provider-source',
      _ => throw StateError('Unexpected provider command $path'),
    };
    if (rejectRuntimeCode case final code?) return _error(code);
    if (body['expectedRevision'] != revision) {
      return _error('revision_conflict');
    }
    if (!path.endsWith(':refresh') && body['sourceVersion'] != sourceVersion) {
      return _error('source_target_changed');
    }
    final operationId = body['operationId'] as String;
    final operation = <String, Object?>{
      'operationId': operationId,
      'desiredRevision': (BigInt.parse(revision) + BigInt.one).toString(),
      'action': action,
      'phase': 'pending',
      'updatedAt': '2026-11-15T00:00:00Z',
    };
    operations[operationId] = operation;
    if (!accepted.isCompleted) accepted.complete();
    return _commit(body, {...operation, ...acceptedPatch});
  }

  @override
  void close() {}
}

Future<(WebApiRepository, WebExternalProviderWorkflows)> _workflows(
  _ProviderTransport transport, {
  bool? consent,
}) async {
  final repo = WebApiRepository(
    transport: transport,
    journal: MemoryApiOperationJournal(),
  );
  await repo.initialize();
  final helper = WebExternalProviderWorkflows(
    repo,
    confirmSource: consent == null ? null : (_) async => consent,
  );
  return (repo, helper);
}

Future<WebOpaqueProviderSource> _opaque(
  WebApiRepository repo,
  WebExternalProviderWorkflows helper,
) async => (await helper.sources(
  repo.identities.decode(ApiIdentity.profile, _profileId),
)).single;

List<ApiRequest> _businessPosts(_ProviderTransport transport) => transport
    .requests
    .where((r) => r.method == 'POST' && !r.path.startsWith('/api/v1/sources:'))
    .toList();

void main() {
  // These tests exercise external_providers.dart's public workflow, not a raw
  // filesystem/CoreRPC substitute. All URLs and transports are synthetic.
  test(
    'external provider contract keeps 256-bit opaque IDs and original read versions',
    () async {
      final transport = _ProviderTransport();
      final (repo, helper) = await _workflows(transport);
      addTearDown(repo.close);
      final source = await _opaque(repo, helper);
      expect(source.id, _opaqueId);
      expect(source.purpose, WebExternalProviderPurpose.rules);
      expect(source.sourceVersion, _version);
      final head = await helper.head(source);
      expect(head.prepared, true);
      expect(identical(head.editVersion, source.editVersion), true);
      final document = await helper.read(source);
      expect(document.bytes, transport.opaqueBytes);
      expect(document.sha256, crypto.sha256.convert(document.bytes).toString());
      expect(identical(document.editVersion, source.editVersion), true);
      expect(() => document.bytes[0] = 0, throwsUnsupportedError);
      final preview = await helper.preview(source);
      expect(preview.text, utf8.decode(transport.opaqueBytes));
      expect(preview.format, WebExternalProviderFormat.text);
      expect(preview.readOnly, false);
      expect(await helper.download(source), document.bytes);
      expect(
        transport.requests.any(
          (r) =>
              r.path.contains('/download') ||
              r.path.contains('/data/') ||
              r.path.contains('coreRpc'),
        ),
        false,
      );
    },
  );

  test(
    'external provider contract waits HTTP pending through the same operation applied result',
    () async {
      final transport = _ProviderTransport()
        ..runtimeGate = Completer<void>()
        ..pendingReads = 1;
      final (repo, helper) = await _workflows(transport);
      addTearDown(repo.close);
      final source = await _opaque(repo, helper);
      final document = await helper.read(source);
      var completed = false;
      final writing = helper.write(document, utf8.encode('payload: []\n')).then(
        (result) {
          completed = true;
          return result;
        },
      );
      await transport.accepted.future;
      expect(completed, false);
      transport.runtimeGate!.complete();
      final result = await writing;
      expect(result.requiresApply, true);
      expect(result.runtimePreparationConfirmed, true);
      expect(result.content, null);
      expect(identical(result.binding, source), true);
      final command = _businessPosts(transport).single;
      final body = jsonDecode(command.body!) as Map;
      expect(body['expectedRevision'], '1');
      expect(body['sourceVersion'], _version);
      expect(
        base64Decode(body['bytes'] as String),
        utf8.encode('payload: []\n'),
      );
      final operationId = body['operationId'];
      expect(
        transport.requests
            .where((r) => r.path == '/api/v1/runtime/operations/$operationId')
            .length,
        2,
      );
      expect(
        transport.requests.any((r) => r.path == '/api/v1/runtime/state'),
        false,
      );
    },
  );

  test(
    'external provider contract recovers lost pending receipt using the original operation ID',
    () async {
      final transport = _ProviderTransport()..loseNextMutation = true;
      final (repo, helper) = await _workflows(transport);
      addTearDown(repo.close);
      final original = await helper.read(await _opaque(repo, helper));
      final result = await helper.write(original, utf8.encode('payload: []'));
      expect(result.runtimePreparationConfirmed, true);
      final body = jsonDecode(_businessPosts(transport).single.body!) as Map;
      final operationId = body['operationId'];
      expect(
        transport.requests.any(
          (r) => r.path == '/api/v1/operations/$operationId',
        ),
        true,
      );
      expect(
        transport.requests.any(
          (r) => r.path == '/api/v1/runtime/operations/$operationId',
        ),
        true,
      );
      expect(transport.operations.length, 1);
    },
  );

  for (final terminal in ['failed', 'unknown']) {
    test(
      'external provider contract never promotes runtime $terminal to a prepared result',
      () async {
        final transport = _ProviderTransport()..terminalPhase = terminal;
        final (repo, helper) = await _workflows(transport);
        addTearDown(repo.close);
        final original = await helper.read(await _opaque(repo, helper));
        await expectLater(
          helper.write(original, utf8.encode('payload: []')),
          throwsA(
            isA<WebApiException>()
                .having((e) => e.code, 'code', 'effect_unknown')
                .having((e) => (e.details as Map)['phase'], 'phase', terminal),
          ),
        );
        expect(_businessPosts(transport).length, 1);
      },
    );
  }

  for (final patch in [
    {'id': '1'},
    {'sourceVersion': List.filled(64, 'c').join()},
    {'prepared': false},
    {'requiresApply': false},
    {
      'source': {'id': _opaqueId},
    },
  ]) {
    test(
      'external provider contract rejects malformed applied result $patch',
      () async {
        final transport = _ProviderTransport()..resultPatch = patch;
        final (repo, helper) = await _workflows(transport);
        addTearDown(repo.close);
        final original = await helper.read(await _opaque(repo, helper));
        await expectLater(
          helper.sideload(original, [0, 255, 1]),
          throwsA(isA<WebApiProtocolException>()),
        );
        expect(_businessPosts(transport).length, 1);
      },
    );
  }

  test(
    'external provider contract supports opaque MRS preview and only explicit binary sideload',
    () async {
      final transport = _ProviderTransport()
        ..mrs = true
        ..opaqueBytes = Uint8List.fromList([0x28, 0xb5, 0x2f, 0xfd, 0, 255]);
      final (repo, helper) = await _workflows(transport);
      addTearDown(repo.close);
      final source = await _opaque(repo, helper);
      final preview = await helper.preview(source);
      expect(preview.text, 'example.test\n');
      expect(preview.readOnly, true);
      expect(preview.format, WebExternalProviderFormat.mrs);
      await expectLater(
        helper.write(preview.document, utf8.encode('changed')),
        throwsA(isA<WebApiException>()),
      );
      expect(_businessPosts(transport), isEmpty);
      final result = await helper.sideload(preview.document, [
        0x28,
        0xb5,
        0x2f,
        0xfd,
        0,
        128,
        255,
      ]);
      expect(result.requiresApply, true);
      final command = _businessPosts(transport).single;
      expect(command.path, '$_opaqueRoot:sideload');
      expect(
        base64Decode((jsonDecode(command.body!) as Map)['bytes'] as String),
        [0x28, 0xb5, 0x2f, 0xfd, 0, 128, 255],
      );
    },
  );

  test(
    'external provider contract preserves arbitrary bytes for download but never invents text',
    () async {
      final transport = _ProviderTransport()
        ..opaqueBytes = Uint8List.fromList([255, 0, 128]);
      final (repo, helper) = await _workflows(transport);
      addTearDown(repo.close);
      final source = await _opaque(repo, helper);
      final document = await helper.read(source);
      expect(document.format, WebExternalProviderFormat.binary);
      expect(await helper.download(source), [255, 0, 128]);
      await expectLater(
        helper.preview(source),
        throwsA(isA<WebApiException>()),
      );
      await expectLater(
        helper.write(document, utf8.encode('changed')),
        throwsA(isA<WebApiException>()),
      );
      expect(_businessPosts(transport), isEmpty);
    },
  );

  test(
    'external provider contract keeps unprepared head explicit and refreshes using fixed purpose consent',
    () async {
      final transport = _ProviderTransport()..sourcePhase = 'unprepared';
      final (repo, helper) = await _workflows(transport);
      addTearDown(repo.close);
      final source = await _opaque(repo, helper);
      final head = await helper.head(source);
      expect(head.prepared, false);
      expect(head.size, 0);
      expect(head.sha256, '');
      await expectLater(
        helper.read(source),
        throwsA(
          isA<WebApiException>().having(
            (e) => e.code,
            'code',
            'provider_source_unavailable',
          ),
        ),
      );
      final result = await helper.refresh(head);
      expect(result.requiresApply, true);
      expect(result.runtimePreparationConfirmed, true);
      final prepare =
          jsonDecode(
                transport.requests
                    .firstWhere((r) => r.path == '/api/v1/sources:prepare')
                    .body!,
              )
              as Map;
      expect(prepare, {
        'expectedRevision': '1',
        'purpose': 'external-provider-refresh',
        'key': {'kind': 'external-provider', 'id': _opaqueId},
      });
      final body = jsonDecode(_businessPosts(transport).single.body!) as Map;
      expect(body['id'], _opaqueId);
      expect(body['purpose'], 'rule-providers');
      expect(body['expectedRevision'], '1');
      expect(body.containsKey('url'), false);
    },
  );

  for (final consent in <bool?>[null, false, true]) {
    test(
      'external provider contract private refresh consent is explicit: $consent',
      () async {
        final transport = _ProviderTransport()..privateSource = true;
        final (repo, helper) = await _workflows(transport, consent: consent);
        addTearDown(repo.close);
        final head = await helper.head(await _opaque(repo, helper));
        if (consent != true) {
          await expectLater(
            helper.refresh(head),
            throwsA(
              isA<WebApiException>().having(
                (e) => e.code,
                'code',
                consent == null
                    ? 'source_authorization_required'
                    : 'source_authorization_cancelled',
              ),
            ),
          );
          expect(_businessPosts(transport), isEmpty);
          expect(
            transport.requests.any(
              (r) => r.path == '/api/v1/sources:authorize',
            ),
            false,
          );
        } else {
          final result = await helper.refresh(head);
          expect(result.requiresApply, true);
          final command =
              jsonDecode(_businessPosts(transport).single.body!) as Map;
          expect(command['authorizationId'], List.filled(43, 'G').join());
          expect(command['expectedRevision'], '1');
          expect(
            transport.requests
                .where((r) => r.path == '/api/v1/sources:authorize')
                .length,
            1,
          );
        }
      },
    );
  }

  test(
    'external provider contract managed profile and rule-provider bindings retain distinct identities',
    () async {
      final transport = _ProviderTransport();
      final (repo, helper) = await _workflows(transport);
      addTearDown(repo.close);
      final profile = (await repo.profiles().get()).single;
      final provider = (await repo.catalog(repo.providers).get()).single;
      expect(profile.id, isNot(provider.id));
      final profileBinding = helper.managedProfile(profile);
      final ruleBinding = helper.managedRuleProvider(provider);
      final profileDocument = await helper.read(profileBinding);
      final ruleDocument = await helper.read(ruleBinding);
      expect(profileDocument.bytes, transport.profileBytes);
      expect(ruleDocument.bytes, transport.ruleBytes);
      expect(
        identical(profileDocument.editVersion, profileBinding.editVersion),
        true,
      );
      expect(
        identical(ruleDocument.editVersion, ruleBinding.editVersion),
        true,
      );
      expect(
        (await helper.preview(profileBinding)).text,
        utf8.decode(transport.profileBytes),
      );
      expect(
        (await helper.preview(ruleBinding)).text,
        utf8.decode(transport.ruleBytes),
      );
      final result = await helper.write(
        profileDocument,
        utf8.encode('proxies: []\nrules: []\n'),
      );
      expect(result.requiresApply, true);
      expect(result.runtimePreparationConfirmed, false);
      expect(result.content!.profile!.id, profile.id);
