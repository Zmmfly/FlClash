  test(
    'external provider contract rejects changed managed owner after receipt recovery',
    () async {
      final transport = _ProviderTransport()
        ..managedMutationPatch = {
          'content': {
            'key': {'kind': 'profile', 'id': _profileId},
            'mediaType': 'application/yaml',
            'size': 0,
            'sha256': crypto.sha256.convert([]).toString(),
          },
          'profile': {
            'id': _profileId,
            'type': 'file',
            'autoUpdateDurationMillis': 0,
          },
          'ruleProvider': null,
        };
      final (repo, helper) = await _workflows(transport);
      addTearDown(repo.close);
      final original = await helper.read(
        helper.managedRuleProvider(
          (await repo.catalog(repo.providers).get()).single,
        ),
      );
      final version = original.editVersion;
      final before = transport.requests.length;
      late WebApiCommittedProjectionException failure;
      try {
        await helper.write(original, utf8.encode('payload: []'));
        fail(
          'A committed response naming another owner must not become success',
        );
      } on WebApiCommittedProjectionException catch (error) {
        failure = error;
      }
      // The durable command is known committed, but its final canonical
      // projection is invalid. Preserve that stronger shared-client contract.
      expect(failure.code, 'committed_refresh_failed');
      expect(failure.revision, '2');
      final command = _businessPosts(transport).single;
      final payload = jsonDecode(command.body!) as Map;
      expect(failure.operationId, payload['operationId']);
      expect(payload['key'], {'kind': 'rule-provider', 'id': _providerId});
      expect(payload['expectedRevision'], '1');
      expect(repo.pendingOperation, null);
      expect(repo.revision, '2');
      expect(identical(original.editVersion, version), true);
      expect(version.revision, '1');
      expect(original.binding, isA<WebManagedRuleProvider>());
      // No compensation/rewrite, automatic apply, fresh read or fresh token.
      expect(
        transport.requests
            .skip(before)
            .map((row) => '${row.method} ${row.path}')
            .toList(),
        ['POST /api/v1/content:write'],
      );
    },
  );

