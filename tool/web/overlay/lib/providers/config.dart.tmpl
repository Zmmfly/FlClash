@riverpod
class AppSetting extends _$AppSetting
    with WebSettingsNotifierMixin<AppSettingProps> {
  @override
  WebSettingsSection get settingsSection => WebSettingsSection.app;
  @override
  AppSettingProps build() => ref.watch(
    webSettingsConfigProvider.select((value) => value.appSettingProps),
  );
}

