@Riverpod(name: 'configProvider')
Config _config(Ref ref) => ref.watch(webSettingsConfigProvider);

void writeConfig(Ref ref, Config config) {
  throw const WebApiProtocolException(
    'Whole Config writes are not a Web settings command; use server backup restore',
  );
}

Future<void> reloadWebSettings(Ref ref) =>
    ref.read(webSettingsControllerProvider).load(refresh: true);

List<Override> buildConfigOverrides(Config config) => [
  webSettingsInitialConfigProvider.overrideWithValue(config),
];
