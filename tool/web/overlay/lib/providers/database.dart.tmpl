@riverpod
class MitmModules extends _$MitmModules
    with
        AsyncNotifierMixin<List<MitmModule>>,
        _Committed<List<MitmModule>>,
        _CatalogWrites<MitmModule> {
  @override
  ApiCatalog<MitmModule> get catalogSpec => database.repository.modules;
  @override
  List<MitmModule> get value => state.value ?? [];
  @override
  Stream<List<MitmModule>> build() {
    final query = database.mitmModulesDao.query();
    return committed(query.watch(), query.get, const []);
  }

  @override
  Future<void> put(
    MitmModule item, {
    bool first = false,
    ApiEditVersion? editVersion,
  }) {
    if (first &&
        !database.repository.identities.isBound(
          ApiIdentity.mitmModule,
          item.id,
        )) {
      final version = _needVersion(editVersion);
      return submit(() async {
        await database.repository.replaceCatalog(catalogSpec, [
          item,
          ...value,
        ], editVersion: version);
      });
    }
    return super.put(item, editVersion: editVersion);
  }

  @override
  bool updateShouldNotify(
    AsyncValue<List<MitmModule>> previous,
    AsyncValue<List<MitmModule>> next,
  ) => !mitmModuleListEquality.equals(previous.value, next.value);
}

mixin _RuleListMixin on _Committed<List<Rule>> {
  int? get ownerId;
  @override
  List<Rule> get value => state.value ?? [];

  Future<void> persistRule(Rule rule, {ApiEditVersion? editVersion}) async {
    await database.repository.saveRule(
      rule,
      profileId: ownerId,
      editVersion: editVersion,
    );
  }

  Future<void> put(Rule rule, {ApiEditVersion? editVersion}) =>
      submit(() => persistRule(rule, editVersion: editVersion));

  Future<void> putAll(List<Rule> rules, {ApiEditVersion? editVersion}) {
    final version =
        editVersion ??
        database.repository.captureEditVersion(ApiIdentity.rule, value);
    final next = [...rules, ...value];
    return submit(() async {
      await database.repository.replaceRules(
        ownerId,
        next,
        editVersion: version,
      );
    });
  }

  Future<void> delAll(Iterable<int> ids, {ApiEditVersion? editVersion}) {
    final version =
        editVersion ??
        database.repository.captureEditVersion(ApiIdentity.rule, value);
    return submit(
      () => database.repository.deleteRules(ids, editVersion: version),
    );
  }

  Future<void> insertAfterEach(
    Map<int, Rule> copies, {
    ApiEditVersion? editVersion,
  }) {
    final version =
        editVersion ??
        database.repository.captureEditVersion(ApiIdentity.rule, value);
    final next = <Rule>[];
    for (final item in value) {
      next.add(item);
      if (copies[item.id] case final copy?) next.add(copy);
    }
    return submit(() async {
      await database.repository.replaceRules(
        ownerId,
        next,
        editVersion: version,
      );
    });
  }

  Future<void> order(
    int oldIndex,
    int newIndex, {
    ApiEditVersion? editVersion,
  }) {
    final version =
        editVersion ??
        database.repository.captureEditVersion(ApiIdentity.rule, value);
    final ids = [
      for (final item in value.copyAndReorder(oldIndex, newIndex)) item.id,
    ];
    return submit(
      () => database.repository.reorderRules(
        profileId: ownerId,
        ids: ids,
        editVersion: version,
      ),
    );
  }

  @override
  bool updateShouldNotify(
    AsyncValue<List<Rule>> previous,
    AsyncValue<List<Rule>> next,
  ) => !ruleListEquality.equals(previous.value, next.value);
}

