@Riverpod(keepAlive: true)
class Profiles extends _$Profiles {
  @override
  List<Profile> build() {
    ref.listen(profilesStreamProvider, (_, next) {
      if (!database.repository.isSessionActive) {
        state = [];
      } else if (next.value case final rows?
          when !next.isLoading && !next.hasError) {
        if (database.repository.ownsReadProjection(rows)) state = rows;
      }
    });
    final subscription = database.repository.sessionChanges.listen((_) {
      if (ref.mounted) state = [];
    });
    ref.onDispose(subscription.cancel);
    final initial = ref.read(profilesStreamProvider);
    final rows = initial.value;
    return !initial.isLoading &&
            !initial.hasError &&
            rows != null &&
            database.repository.ownsReadProjection(rows)
        ? rows
        : [];
  }

  Profile labeled(Profile profile) => state.optimizeLabel(profile);

  void adoptCommitted(List<Profile> profiles) {
    database.repository.captureEditVersion(ApiIdentity.profile, profiles);
    state = profiles;
  }

  Future<R> _write<R>(Future<R> Function() action) {
    final repository = database.repository;
    final epoch = repository.client.sessionEpoch;
    return repository.runIntent(() async {
      repository.client.requireSession(epoch);
      final result = await action();
      repository.client.requireSession(epoch);
      final rows = await database.profilesDao.query().get();
      repository.client.requireSession(epoch);
      if (ref.mounted) state = rows;
      return result;
    });
  }

  Future<Profile> putCommitted(
    Profile profile, {
    ApiEditVersion? editVersion,
  }) => _write(
    () => database.repository.saveProfile(
      labeled(profile),
      editVersion: editVersion,
    ),
  );

  Future<void> put(Profile profile, {ApiEditVersion? editVersion}) async {
    await putCommitted(profile, editVersion: editVersion);
  }

  Future<void> resetDialerOverrides(int id, {ApiEditVersion? editVersion}) {
    final version =
        editVersion ??
        database.repository.captureEditVersion(
          ApiIdentity.profile,
          state.getProfile(id)!,
        );
    return _write(() async {
      await database.repository.resetDialerOverrides(id, editVersion: version);
    });
  }

  Future<void> rewriteCustom(
    Future<Map<int, Profile Function(Profile)>> Function() body,
  ) => Future.error(
    UnsupportedError(
      'Web reference rewrites are server-owned typed rename commands',
    ),
  );

  Future<void> del(int id, {ApiEditVersion? editVersion}) {
    final version =
        editVersion ??
        database.repository.captureEditVersion(
          ApiIdentity.profile,
          state.getProfile(id)!,
        );
    return _write(
      () => database.repository.deleteProfile(id, editVersion: version),
    );
  }

  Future<void> updateProfile(
    int id,
    Profile Function(Profile) builder, {
    ApiEditVersion? editVersion,
  }) {
    final previous = state.getProfile(id);
    if (previous == null) {
      return Future.error(
        const WebApiException('not_found', 'Profile not found'),
      );
    }
    final version =
        editVersion ??
        database.repository.captureEditVersion(ApiIdentity.profile, previous);
    final next = builder(previous);
    if (next == previous) return Future.value();
    final saved = _write(() async {
      await database.repository.saveProfile(next, editVersion: version);
    });
    // The shared views fire this without a draft and never await it, so a
    // rejection would otherwise vanish; a draft's owner handles its own.
    return editVersion == null ? globalState.safeRun(() => saved) : saved;
  }

  Future<void> reorder(List<Profile> profiles, {ApiEditVersion? editVersion}) {
    final version =
        editVersion ??
        database.repository.captureCollectionVersion(
          ApiIdentity.profile,
          profiles,
        );
    return _write(
      () => database.repository.reorderProfiles([
        for (final item in profiles) item.id,
      ], editVersion: version),
    );
  }

  @override
  bool updateShouldNotify(List<Profile> previous, List<Profile> next) =>
      !profileListEquality.equals(previous, next);
}

