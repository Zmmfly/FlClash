@riverpod
class ProxyGroups extends _$ProxyGroups
    with AsyncNotifierMixin<List<ProxyGroup>>, _Committed<List<ProxyGroup>> {
  @override
  List<ProxyGroup> get value => state.value ?? [];
  @override
  Stream<List<ProxyGroup>> build(int profileId) {
    final query = database.proxyGroupsDao.query(profileId);
    return committed(query.watch(), query.get, const []);
  }

  Future<void> delAll(Iterable<int> ids, {ApiEditVersion? editVersion}) {
    final version =
        editVersion ??
        database.repository.captureEditVersion(ApiIdentity.proxyGroup, value);
    return submit(
      () =>
          database.proxyGroupsDao.delAll(profileId, ids, editVersion: version),
    );
  }

  Future<bool> put(ProxyGroup group, {ApiEditVersion? editVersion}) async {
    if (value.any((item) => item.name == group.name && item.id != group.id)) {
      return false;
    }
    await submit(() async {
      await database.proxyGroupsDao.save(
        profileId,
        group,
        editVersion: editVersion,
      );
    });
    return true;
  }

  Future<void> setAll(List<ProxyGroup> groups, {ApiEditVersion? editVersion}) {
    final version = _needVersion(editVersion);
    return submit(() async {
      await database.proxyGroupsDao.replace(
        profileId,
        groups,
        editVersion: version,
      );
    });
  }

  Future<void> insertAfterEach(
    Map<int, ProxyGroup> copies, {
    ApiEditVersion? editVersion,
  }) {
    final version =
        editVersion ??
        database.repository.captureEditVersion(ApiIdentity.proxyGroup, value);
    final next = <ProxyGroup>[];
    for (final item in value) {
      next.add(item);
      if (copies[item.id] case final copy?) next.add(copy);
    }
    return submit(() async {
      await database.proxyGroupsDao.replace(
        profileId,
        next,
        editVersion: version,
      );
    });
  }

  Future<void> order(
    int oldIndex,
    int newIndex, {
    ApiEditVersion? editVersion,
  }) {
    final version =
        editVersion ??
        database.repository.captureEditVersion(ApiIdentity.proxyGroup, value);
    final ids = [
      for (final item in value.copyAndReorder(oldIndex, newIndex)) item.id,
    ];
    return submit(
      () =>
          database.proxyGroupsDao.reorder(profileId, ids, editVersion: version),
    );
  }

  @override
  bool updateShouldNotify(
    AsyncValue<List<ProxyGroup>> previous,
    AsyncValue<List<ProxyGroup>> next,
  ) => !proxyGroupsEquality.equals(previous.value, next.value);
}

