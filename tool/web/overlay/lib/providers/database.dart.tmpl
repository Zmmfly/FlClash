Future<void> withRollback<T>({
  required T snapshot,
  required FutureOr<void> Function() action,
  required void Function(T) rollback,
}) async {
  try {
    await action();
  } catch (error, stack) {
    rollback(snapshot);
    Error.throwWithStackTrace(error, stack);
  }
}

ApiEditVersion _needVersion(ApiEditVersion? token) =>
    token ??
    (throw const WebApiException(
      'edit_baseline_required',
      'Keep the version captured before opening the editor',
    ));

Stream<T> _sessionRows<T extends Object>(
  WebApiRepository repository,
  Stream<T> rows,
  T empty,
) =>
    Stream<(T, int, bool)>.multi((controller) {
          var closed = false;
          final subscription = rows.listen(
            (value) {
              if (!closed) {
                controller.add((value, repository.client.sessionEpoch, false));
              }
            },
            onError: (Object error, StackTrace stack) {
              if (!closed && repository.isSessionActive) {
                controller.addError(error, stack);
              }
            },
            onDone: () {
              closed = true;
              controller.close();
            },
          );
          final resets = repository.sessionChanges.listen((_) {
            if (!closed) {
              controller.add((empty, repository.client.sessionEpoch, true));
            }
          });
          controller.onCancel = () async {
            closed = true;
            await subscription.cancel();
            await resets.cancel();
          };
        })
        .where(
          (event) =>
              event.$2 == repository.client.sessionEpoch &&
              (event.$3 || repository.ownsReadProjection(event.$1)),
        )
        .map((event) => event.$1);

mixin _Committed<T extends Object> on AsyncNotifierMixin<T> {
  Future<T> Function()? _query;

  Stream<T> committed(Stream<T> rows, Future<T> Function() query, T empty) {
    _query = query;
    final subscription = database.repository.sessionChanges.listen((_) {
      if (ref.mounted) value = empty;
    });
    ref.onDispose(subscription.cancel);
    return _sessionRows(database.repository, rows, empty);
  }

  Future<R> commit<R>(Future<R> Function() action) {
    final repository = database.repository;
    final epoch = repository.client.sessionEpoch;
    return repository.runIntent(() async {
      repository.client.requireSession(epoch);
      final result = await action();
      repository.client.requireSession(epoch);
      final rows = await _query!();
      repository.client.requireSession(epoch);
      if (ref.mounted) value = rows;
      return result;
    });
  }

  Future<void> submit(Future<void> Function() action) => commit(action);
}

mixin _CatalogWrites<T> on AsyncNotifierMixin<List<T>>, _Committed<List<T>> {
  ApiCatalog<T> get catalogSpec;

  Future<void> put(T item, {ApiEditVersion? editVersion}) => submit(() async {
    await database.repository.saveCatalog(
      catalogSpec,
      item,
      editVersion: editVersion,
    );
  });

  Future<void> del(int id, {ApiEditVersion? editVersion}) {
    final version =
        editVersion ??
        database.repository.captureEditVersion(
          catalogSpec.identity,
          value.firstWhere((item) => catalogSpec.localId(item) == id) as Object,
        );
    return submit(
      () => database.repository.deleteCatalog(catalogSpec, [
        id,
      ], editVersion: version),
    );
  }

  Future<void> order(
    int oldIndex,
    int newIndex, {
    ApiEditVersion? editVersion,
  }) {
    final version =
        editVersion ??
        database.repository.captureEditVersion(catalogSpec.identity, value);
    final next = value.copyAndReorder(oldIndex, newIndex);
    return submit(
      () => database.repository.reorderCatalog(catalogSpec, [
        for (final item in next) catalogSpec.localId(item),
      ], editVersion: version),
    );
  }
}

