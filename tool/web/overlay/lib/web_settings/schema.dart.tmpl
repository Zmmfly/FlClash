void validateWebSettings(Object? value) => _validate(value, webSettingsSchema);

void _validate(Object? value, Object schema) {
  switch (schema) {
    case ('nullable', final Object nested):
      if (value != null) _validate(value, nested);
    case ('map', final Object nested):
      if (value is! Map<String, Object?>) {
        throw const WebApiProtocolException('Invalid settings map');
      }
      for (final item in value.values) {
        _validate(item, nested);
      }
    case final Map<String, Object> fields:
      if (value is! Map<String, Object?> ||
          value.length != fields.length ||
          !fields.keys.every(value.containsKey)) {
        throw const WebApiProtocolException(
          'Settings fields do not match the typed schema',
        );
      }
      for (final entry in fields.entries) {
        _validate(value[entry.key], entry.value);
      }
    case [final Object nested]:
      if (value is! List) {
        throw const WebApiProtocolException('Invalid settings list');
      }
      for (final item in value) {
        _validate(item, nested);
      }
    case 'string':
      if (value is! String) {
        throw const WebApiProtocolException('Invalid settings string');
      }
    case 'bool':
      if (value is! bool) {
        throw const WebApiProtocolException('Invalid settings bool');
      }
    case 'int':
      if (value is! int) {
        throw const WebApiProtocolException('Invalid settings integer');
      }
    default:
      throw const WebApiProtocolException('Invalid settings schema');
  }
