class WebCoreBridge {
  WebCoreBridge._();

  static final WebCoreBridge instance = WebCoreBridge._();

  final Map<String, void Function(int pid)> _connectHandlers = {};
  final Map<String, void Function()> _disconnectHandlers = {};
  final List<void Function()> _networkChangeListeners = [];
  final Set<void Function()> _runtimeSubscriptionListeners = {};
  Future<Map<String, Object?>> Function(Map<String, Object?>)?
  _dispatchTypedCall;
  Future<Map<String, Object?>?> Function(Map<String, Object?>)?
  _receiveTypedEvent;
  Map<String, Object?> Function()? _subscriptionFrame;

  void configureTypedRuntime({
    required Future<Map<String, Object?>> Function(Map<String, Object?>)
    dispatch,
    required Future<Map<String, Object?>?> Function(Map<String, Object?>)
    receiveEvent,
    required Map<String, Object?> Function() subscriptionFrame,
  }) {
    _dispatchTypedCall = dispatch;
    _receiveTypedEvent = receiveEvent;
    _subscriptionFrame = subscriptionFrame;
  }

  Future<Map<String, Object?>> dispatchTypedCall(Map<String, Object?> frame) {
    final dispatch = _dispatchTypedCall;
    if (dispatch == null)
      throw StateError('The typed runtime is not configured');
    return dispatch(frame);
  }

  Future<Map<String, Object?>?> receiveTypedEvent(Map<String, Object?> event) {
    final receive = _receiveTypedEvent;
    if (receive == null)
      throw StateError('The typed runtime is not configured');
    return receive(event);
  }

  Map<String, Object?> typedSubscriptionFrame() {
    final frame = _subscriptionFrame;
    if (frame == null) throw StateError('The typed runtime is not configured');
    return frame();
  }

  void addRuntimeSubscriptionListener(void Function() listener) {
    _runtimeSubscriptionListeners.add(listener);
  }

  void removeRuntimeSubscriptionListener(void Function() listener) {
    _runtimeSubscriptionListeners.remove(listener);
  }

  void notifyRuntimeSubscriptionsChanged() {
    for (final listener in List<void Function()>.of(
      _runtimeSubscriptionListeners,
    )) {
      listener();
    }
  }

  void addNetworkChangeListener(void Function() listener) {
    _networkChangeListeners.add(listener);
  }

  void notifyNetworkChanged() {
    for (final listener in List<void Function()>.of(_networkChangeListeners)) {
      listener();
    }
  }

  void registerServer(
    String address, {
    required void Function(int pid) onConnect,
    required void Function() onDisconnect,
  }) {
    _connectHandlers[address] = onConnect;
    _disconnectHandlers[address] = onDisconnect;
  }

  void unregisterServer(String address) {
    _connectHandlers.remove(address);
    _disconnectHandlers.remove(address);
  }

  void notifyProcessStarted(String address, int pid) {
    final handler = _connectHandlers[address];
    if (handler != null) {
      handler(pid);
    } else {
      for (final h in _connectHandlers.values) {
        h(pid);
      }
    }
  }

  void notifyProcessKilled(String address) {
    final handler = _disconnectHandlers[address];
    if (handler != null) {
      handler();
    }
  }
}
