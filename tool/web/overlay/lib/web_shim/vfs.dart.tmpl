import 'dart:typed_data';

import 'package:path/path.dart' as p;

import 'js_bridge.dart';

class VfsNode {
  String path;
  bool isDir;
  int size;
  int mtimeMs;
  Uint8List? bytes;

  VfsNode({
    required this.path,
    required this.isDir,
    this.size = 0,
    int? mtimeMs,
    this.bytes,
  }) : mtimeMs = mtimeMs ?? DateTime.now().millisecondsSinceEpoch;
}

class WebNetInterface {
  final String name;
  final List<String> addresses;

  WebNetInterface({required this.name, required this.addresses});
}

class WebFileSystem {
  WebFileSystem._();

  static final WebFileSystem instance = WebFileSystem._();
  static const maxFileBytes = 32 * 1024 * 1024;
  static const maxMemoryBytes = 96 * 1024 * 1024;
  static const maxNodes = 2048;
  static const _directories = {
    '/', '/data', '/data/profiles', '/data/providers', '/tmp', '/downloads',
  };

  final Map<String, VfsNode> _nodes = {};
  List<WebNetInterface> _networkInterfaces = const [];
  bool _initialized = false;

  List<WebNetInterface> get networkInterfaces =>
      List.unmodifiable(_networkInterfaces);

  Future<void> refreshNetworkInterfaces() async {
    final response = await JsBridge.asyncJsonRequest(
      'GET',
      '/api/v1/runtime/network-interfaces',
    );
    if (response['data'] case final List items) {
      _networkInterfaces = [
        for (final item in items)
          if (item case {'name': final String name, 'addresses': final List values})
            WebNetInterface(name: name, addresses: values.cast<String>()),
      ];
      return;
    }
    throw StateError('Network-interface resource is unavailable');
  }

  String normalize(String rawPath) {
    if (rawPath.contains('\u0000')) {
      throw ArgumentError('Invalid temporary buffer path');
    }
    if (rawPath.isEmpty) return '/data';
    return p.posix.normalize(rawPath.startsWith('/') ? rawPath : '/data/$rawPath');
  }

  bool _ephemeral(String path) =>
      path.startsWith('/tmp/') || path.startsWith('/downloads/');

  void _requireEphemeral(String path) {
    if (!_ephemeral(path)) {
      throw UnsupportedError('Persistent resources require their typed API');
    }
  }

  void ensureInitialized() {
    if (_initialized) return;
    for (final directory in _directories) {
      _nodes[directory] = VfsNode(path: directory, isDir: true);
    }
    _initialized = true;
  }

  void _parents(String path) {
    var parent = p.posix.dirname(path);
    while (!_directories.contains(parent)) {
      _requireEphemeral(parent);
      _nodes.putIfAbsent(parent, () => VfsNode(path: parent, isDir: true));
      parent = p.posix.dirname(parent);
    }
  }

  VfsNode? stat(String rawPath) {
    ensureInitialized();
    final path = normalize(rawPath);
    if (!_directories.contains(path) && !_ephemeral(path)) {
      if (path.startsWith('/data/')) _requireEphemeral(path);
      return null;
    }
    return _nodes[path];
  }

  bool exists(String rawPath) => stat(rawPath) != null;
  bool isDirectory(String rawPath) => stat(rawPath)?.isDir == true;
  bool isFile(String rawPath) => stat(rawPath)?.isDir == false;

  Uint8List readBytes(String rawPath) {
    final path = normalize(rawPath);
    _requireEphemeral(path);
    final node = stat(path);
    if (node == null || node.isDir || node.bytes == null) {
      throw StateError('Temporary buffer does not exist');
    }
    return Uint8List.fromList(node.bytes!);
  }

  void writeBytes(String rawPath, List<int> data, {bool append = false}) {
    ensureInitialized();
    final path = normalize(rawPath);
    _requireEphemeral(path);
    if (_nodes[path]?.isDir == true) {
      throw StateError('Cannot write a directory');
    }
    final previous = _nodes[path]?.bytes;
    final length = data.length + (append ? previous?.length ?? 0 : 0);
    if (length > maxFileBytes) throw StateError('Temporary buffer exceeds 32 MiB');
    final memory = _nodes.values.fold<int>(0, (total, node) => total + (node.bytes?.length ?? 0));
    if (memory - (previous?.length ?? 0) + length > maxMemoryBytes ||
        _nodes.length + path.split('/').length > maxNodes) {
      throw StateError('Temporary buffer capacity exceeded');
    }
    final bytes = append && previous != null
        ? (BytesBuilder(copy: false)..add(previous)..add(data)).takeBytes()
        : Uint8List.fromList(data);
    if (path.startsWith('/downloads/')) {
      if (!JsBridge.triggerDownload(p.posix.basename(path), bytes)) {
        throw StateError('Browser download failed');
      }
    }
    _parents(path);
    _nodes[path] = VfsNode(path: path, isDir: false, size: bytes.length, bytes: bytes);
  }

  void mkdir(String rawPath, {bool recursive = false}) {
    ensureInitialized();
    final path = normalize(rawPath);
    if (_directories.contains(path)) return;
    _requireEphemeral(path);
    if (_nodes[path]?.isDir == false) throw StateError('A buffer already exists');
    if (_nodes.length + path.split('/').length > maxNodes) {
      throw StateError('Temporary buffer capacity exceeded');
    }
    if (recursive) {
      _parents(path);
    } else if (_nodes[p.posix.dirname(path)]?.isDir != true) {
      throw StateError('Temporary parent does not exist');
    }
    _nodes[path] = VfsNode(path: path, isDir: true);
  }

  void delete(String rawPath, {bool recursive = false}) {
    ensureInitialized();
    final path = normalize(rawPath);
    _requireEphemeral(path);
    final prefix = '$path/';
    if (!recursive && _nodes.keys.any((key) => key.startsWith(prefix))) {
      throw StateError('Temporary directory is not empty');
    }
    _nodes.remove(path);
    if (recursive) _nodes.removeWhere((key, _) => key.startsWith(prefix));
  }

  void rename(String fromRaw, String toRaw) {
    ensureInitialized();
    final from = normalize(fromRaw);
    final to = normalize(toRaw);
    _requireEphemeral(from);
    _requireEphemeral(to);
    if (from == to) return;
    if (_nodes.containsKey(to) || to.startsWith('$from/')) {
      throw StateError('Invalid temporary buffer destination');
    }
    final source = _nodes[from];
    if (source == null) throw StateError('Temporary buffer does not exist');
    if (to.startsWith('/downloads/') && !source.isDir) {
      copy(from, to);
      delete(from);
      return;
    }
    _parents(to);
    final moved = <String, VfsNode>{};
    final prefix = '$from/';
    for (final entry in _nodes.entries) {
      if (entry.key == from || entry.key.startsWith(prefix)) {
        final path = '$to${entry.key.substring(from.length)}';
        moved[path] = VfsNode(path: path, isDir: entry.value.isDir,
          size: entry.value.size, mtimeMs: entry.value.mtimeMs, bytes: entry.value.bytes);
      }
    }
    _nodes.removeWhere((key, _) => key == from || key.startsWith(prefix));
    _nodes.addAll(moved);
  }

  void copy(String fromRaw, String toRaw) => writeBytes(toRaw, readBytes(fromRaw));

  List<VfsNode> list(String rawDir, {bool recursive = false}) {
    ensureInitialized();
    final path = normalize(rawDir);
    if (path != '/tmp' && path != '/downloads') _requireEphemeral(path);
    final prefix = '$path/';
    return [
      for (final entry in _nodes.entries)
        if (entry.key.startsWith(prefix) &&
            (recursive || !entry.key.substring(prefix.length).contains('/')))
          entry.value,
    ];
  }
}
