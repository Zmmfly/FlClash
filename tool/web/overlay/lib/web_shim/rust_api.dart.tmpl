@JS('window.__flclashWeb.CoreWebSocket')
extension type _JSWebSocket._(JSObject _) implements JSObject {
  external factory _JSWebSocket(JSString url);
  external int get readyState;
  external set onopen(JSFunction? handler);
  external set onmessage(JSFunction? handler);
  external set onclose(JSFunction? handler);
  external set onerror(JSFunction? handler);
  external void send(JSAny data);
  external void close();
}

@JS()
extension type _JSMessageEvent._(JSObject _) implements JSObject {
  external JSAny? get data;
}

class RustLib {
  RustLib._();
  static final RustLib instance = RustLib._();

  bool _initialized = true;
  bool get initialized => _initialized;

  static Future<void> init() async {
    instance._initialized = true;
  }
}

bool get isRustLibInitialized => RustLib.instance.initialized;

class HotKeyFailure {
  final int id;
  final String reason;

  const HotKeyFailure({required this.id, required this.reason});

  @override
  int get hashCode => id.hashCode ^ reason.hashCode;

  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      other is HotKeyFailure &&
          runtimeType == other.runtimeType &&
          id == other.id &&
          reason == other.reason;
}

enum HotKeyModifier { alt, capsLock, control, fn, meta, shift }

class HotKeySpec {
  final int id;
  final int key;
  final List<HotKeyModifier> modifiers;

  const HotKeySpec({
    required this.id,
    required this.key,
    required this.modifiers,
  });

  @override
  int get hashCode => id.hashCode ^ key.hashCode ^ modifiers.hashCode;

  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      other is HotKeySpec &&
          runtimeType == other.runtimeType &&
          id == other.id &&
          key == other.key &&
          modifiers == other.modifiers;
}

Stream<int> hotKeyEvents() => const Stream<int>.empty();

Future<List<HotKeyFailure>> setHotKeys({
  required List<HotKeySpec> specs,
}) async {
  return const [];
}

Future<String> evaluateScript({
  required String script,
  required String config,
}) async {
  return JsBridge.evalClashScript(script, config);
}

enum IpcEventKind { connected, message, disconnected, failed }

class IpcEvent {
  final IpcEventKind kind;
  final int? pid;
  final Uint8List payload;
  final String? error;

  const IpcEvent({
    required this.kind,
    this.pid,
    required this.payload,
    this.error,
  });

  @override
  int get hashCode =>
      kind.hashCode ^ pid.hashCode ^ payload.hashCode ^ error.hashCode;

  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      other is IpcEvent &&
          runtimeType == other.runtimeType &&
          kind == other.kind &&
          pid == other.pid &&
          payload == other.payload &&
          error == other.error;
}

class IpcServer {
  final String address;
  final StreamController<IpcEvent> _controller =
      StreamController<IpcEvent>.broadcast();
  _JSWebSocket? _ws;
  bool _closed = false;
  int _generation = 0;
  int _inFlight = 0;
  Future<void> _eventQueue = Future<void>.value();
  late final void Function() _subscriptionListener;

  IpcServer._(this.address) {
    _subscriptionListener = () {
      final ws = _ws;
      if (!_closed && ws != null && ws.readyState == 1) _subscribe(ws);
    };
    WebCoreBridge.instance.addRuntimeSubscriptionListener(
      _subscriptionListener,
    );
    WebCoreBridge.instance.registerServer(
      address,
      onConnect: _connectWebSocket,
      onDisconnect: _disconnectWebSocket,
    );
  }

  static Future<IpcServer> bind({required String address}) async =>
      IpcServer._(address);

  void _subscribe(_JSWebSocket ws) {
    ws.send(jsonEncode(WebCoreBridge.instance.typedSubscriptionFrame()).toJS);
  }

  void _emit(Map<String, Object?> frame) {
    if (_closed) return;
    _controller.add(
      IpcEvent(
        kind: IpcEventKind.message,
        payload: Uint8List.fromList(utf8.encode(jsonEncode(frame))),
      ),
    );
  }

  void _connectWebSocket(int pid) {
    if (_closed) return;
    _generation++;
    _ws?.close();
    final ws = _JSWebSocket(JsBridge.wsUrl('/ws/v1/events').toJS);
    _ws = ws;
    final generation = _generation;
    ws.onopen = ((JSAny? _) {
      if (_closed || _ws != ws) return;
      _subscribe(ws);
      _controller.add(
        IpcEvent(kind: IpcEventKind.connected, pid: pid, payload: Uint8List(0)),
      );
    }).toJS;
    ws.onmessage = ((_JSMessageEvent event) {
      if (_closed || _ws != ws) return;
      final data = event.data;
      if (data == null || !data.isA<JSString>()) return;
      final text = (data as JSString).toDart;
      _eventQueue = _eventQueue
          .then((_) async {
            if (_closed || generation != _generation) return;
            final raw = jsonDecode(text);
            if (raw is! Map<String, Object?>)
              throw const FormatException('Invalid typed event');
            final frame = await WebCoreBridge.instance.receiveTypedEvent(raw);
            if (!_closed && generation == _generation && frame != null)
              _emit(frame);
          })
          .catchError((Object error, StackTrace stack) {
            if (!_closed && generation == _generation) {
              _controller.add(
                IpcEvent(
                  kind: IpcEventKind.failed,
                  payload: Uint8List(0),
                  error: 'Typed event synchronization failed',
                ),
              );
            }
          });
    }).toJS;
    ws.onclose = ((JSAny? _) {
      if (_closed || _ws != ws) return;
      _generation++;
      _ws = null;
      _controller.add(
        IpcEvent(kind: IpcEventKind.disconnected, payload: Uint8List(0)),
      );
    }).toJS;
    ws.onerror = ((JSAny? _) {
      if (_closed || _ws != ws) return;
      _controller.add(
        IpcEvent(
          kind: IpcEventKind.failed,
          payload: Uint8List(0),
          error: 'Authenticated event connection failed',
        ),
      );
    }).toJS;
  }

  void _disconnectWebSocket() {
    if (_closed) return;
    _generation++;
    _ws?.close();
    _ws = null;
    _controller.add(
      IpcEvent(kind: IpcEventKind.disconnected, payload: Uint8List(0)),
    );
  }

  Stream<IpcEvent> events() => _controller.stream;

  void send({required List<int> message}) {
    if (_closed) throw StateError('The browser Core facade is closed');
    final raw = jsonDecode(utf8.decode(message));
    if (raw is! Map<String, Object?>)
      throw const FormatException('Invalid browser IPC call');
    final id = raw['id'];
    if (_inFlight >= 64) {
      _emit({
        if (id is String) 'id': id,
        'result': null,
        'error': {
          'code': 'busy',
          'message': 'Too many pending typed HTTP calls',
          'details': null,
        },
      });
      return;
    }
    final generation = _generation;
    _inFlight++;
    unawaited(
      WebCoreBridge.instance
          .dispatchTypedCall(raw)
          .then((response) {
            if (_closed || generation != _generation) return;
            _emit(response);
            if (response['error'] == null &&
                const {
                  'config.setup',
                  'config.update',
                  'listener.start',
                  'listener.stop',
                }.contains(raw['method'])) {
              WebCoreBridge.instance.notifyNetworkChanged();
            }
          })
          .whenComplete(() {
            _inFlight--;
          }),
    );
  }

  Future<void> close() async {
    if (_closed) return;
    _closed = true;
    _generation++;
    WebCoreBridge.instance.removeRuntimeSubscriptionListener(
      _subscriptionListener,
    );
    WebCoreBridge.instance.unregisterServer(address);
    _ws?.close();
    _ws = null;
    await _controller.close();
  }
}

Future<Uint8List?> transcodeCharset({
  required List<int> bytes,
  required String label,
  required bool lossy,
}) async {
  try {
    return Uint8List.fromList(bytes);
  } catch (_) {
    return null;
  }
}
