  Future<ApiReceipt> recoverOperation(
    String operationId, {
    bool replay = false,
    bool resolve = false,
  }) => _serialize(() async {
    if (_completed[operationId] case final receipt?) return receipt;
    final operation = _client.pendingOperation;
    if (operation == null || operation.operationId != operationId) {
      throw const WebApiProtocolException('Unknown pending operation');
    }
    final barrier = Completer<void>();
    _writeBarrier = barrier;
    try {
      final receipt = await (resolve
          ? _client.resolveOperation(operationId)
          : replay
          ? _client.retryOperation(operationId)
          : _client.recoverOperation(operationId));
      _accept(operation, receipt);
      _client.completeOperation(receipt);
      _pendingRecoveryError = null;
      _invalidate(operation.scope, notify: false);
      _remember(receipt);
      return receipt;
    } on WebApiSessionException {
      rethrow;
    } on WebApiException catch (error) {
      if (_client.pendingOperation != null) _pendingRecoveryError = error;
      if (error.revision case final revision?) {
        _client.observeRevision(revision, scope: operation.scope);
      }
      _invalidate(operation.scope, notify: false);
      rethrow;
    } finally {
      _releaseBarrier(barrier);
    }
  });

  ApiQuery<T> _query<T>(String path, T Function(Object?) decode) =>
      queryProjection(() async {
        final receipt = await _readReceipt(
          path,
          ApiRevisionScope.configuration,
        );
        return _tagCollection(
          _decodeList(receipt.data, decode),
          _resourceIdentity(path),
          receipt.revision,
          path,
        );
      });

  Future<ApiReceipt> _readReceipt(
    String path,
    ApiRevisionScope scope, {
    bool bypass = false,
    bool force = false,
  }) async {
    final epoch = _client.sessionEpoch;
    _client.requireSession(epoch);
    _requireStore();
    if (!bypass) await _drainReadBoundary(epoch);
    if (_storeId == null && path != '/api/v1/meta') {
      await _readReceipt(
        '/api/v1/meta',
        ApiRevisionScope.configuration,
        bypass: true,
      );
    }
    if (_writeBarrier case final barrier? when !bypass) await barrier.future;
    _client.requireSession(epoch);
    if (_client.pendingOperation case final pending? when !bypass) {
      throw WebApiPendingOperationException(pending.operationId);
    }
    final key = (path, scope);
    if (force) _cache.remove(key);
    for (var attempt = 0; attempt < 5; attempt++) {
      final generation = _generation;
      final cached = _cache[key];
      if (cached != null && cached.revision == _client.revisionFor(scope)) {
        return cached;
      }
      final readKey = (path, scope, generation, epoch);
      final future = _reads.putIfAbsent(
        readKey,
        () => _client.read(path, scope: scope),
      );
      final ApiReceipt receipt;
      try {
        receipt = await future;
      } finally {
        if (identical(_reads[readKey], future)) {
          final _ = _reads.remove(readKey);
        }
      }
      _client.requireSession(epoch);
      if (generation != _generation) continue;
      if (path == '/api/v1/meta') _acceptMeta(receipt);
      if (receipt.revision != _client.revisionFor(scope)) continue;
      final advanced = _cache.entries.any(
        (entry) =>
            entry.key.$2 == scope && entry.value.revision != receipt.revision,
      );
      _cache.removeWhere(
        (key, value) => key.$2 == scope && value.revision != receipt.revision,
      );
      _cache[key] = receipt;
      if (advanced) _notify();
      return receipt;
    }
    throw const WebApiException(
      'revision_unstable',
      'The server revision changed repeatedly; retry the read',
    );
  }

  Future<ApiReceipt> _mutate(
    String path,
    Map<String, Object?> payload, {
    List<ApiDraftBinding> drafts = const [],
    List<String> refresh = const [],
    ApiRevisionScope scope = ApiRevisionScope.configuration,
    ApiEditVersion? editVersion,
    String? operationId,
  }) => _serialize(() async {
    if (scope == ApiRevisionScope.configuration) {
      if (editVersion == null) {
        throw const WebApiException(
          'edit_baseline_required',
          'Capture the actual read version before issuing a command',
        );
      }
      _validateVersion(editVersion);
      if (editVersion.scope != ApiRevisionScope.configuration) {
        throw const WebApiException(
          'edit_baseline_mismatch',
          'Cache revisions cannot authorize business commands',
        );
      }
    }
    if (_client.pendingOperation case final pending?) {
      throw WebApiPendingOperationException(pending.operationId);
    }
    if (_storeId == null) await initialize();
    if (_client.revisionFor(scope) == null) {
      await _readReceipt(
        scope == ApiRevisionScope.configuration
            ? '/api/v1/meta'
            : '/api/v1/icon-cache?query=',
        scope,
        bypass: true,
      );
    }
    final barrier = Completer<void>();
    _writeBarrier = barrier;
    try {
      ApiReceipt receipt;
      try {
        receipt = await _client.command(
          path,
          payload,
          drafts: drafts,
          scope: scope,
          expectedRevision: editVersion?.revision,
          operationId: operationId,
        );
      } on WebApiUnknownCommitException catch (error) {
        if (!_receiptEvents.remove(error.operationId)) rethrow;
        receipt = await _client.recoverOperation(error.operationId);
      }
      final operation = _client.requirePendingReceipt(receipt);
      try {
        _accept(operation, receipt);
      } on WebApiOperationSupersededException {
        rethrow;
      } catch (_) {
        throw WebApiUnknownCommitException(operation.operationId);
      }
      _client.completeOperation(receipt);
      _invalidate(scope, notify: false);
      _remember(receipt);
      try {
        for (final resource in refresh) {
          await _readReceipt(resource, scope, bypass: true);
        }
      } catch (_) {
        throw WebApiCommittedProjectionException(
          receipt.operationId!,
          receipt.revision,
        );
      }
      return receipt;
    } on WebApiSessionException {
      rethrow;
    } on WebApiException catch (error) {
      if (error.revision case final revision?) {
        _client.observeRevision(revision, scope: scope);
      }
      _invalidate(scope, notify: false);
      rethrow;
    } finally {
      _releaseBarrier(barrier);
    }
  });

  Future<T> _serialize<T>(Future<T> Function() body) => runIntent(() {
    final epoch = _client.sessionEpoch;
    final run = _queue.then((_) {
      _client.requireSession(epoch);
      _requireStore();
      return body();
    });
    _queue = run.then<void>((_) {}, onError: (Object _) {});
    return run;
  });

  void _accept(ApiPendingOperation operation, ApiReceipt receipt) {
    _client.requirePendingReceipt(receipt);
    if (!identical(_client.pendingOperation, operation) ||
        receipt.operationId != operation.operationId) {
      throw const WebApiOperationSupersededException();
    }
    if (operation.path == '/api/v1/sources:authorize') {
      _recordDependencyGrant(operation, receipt);
      final data = apiObject(receipt.data);
      if (data['importOperationId'] case final String importOperationId) {
        requireApiOperationId(importOperationId);
        _authorizedOperations[importOperationId] = (
          _storeId!,
          _client.sessionEpoch,
          operation.expectedRevision,
        );
      }
    }
    for (final binding in operation.drafts) {
      Object? source = binding.index == null
          ? receipt.data
          : apiList(receipt.data)[binding.index!];
      for (final segment in binding.path) {
        source = segment is int
            ? apiList(source)[segment]
            : apiObject(source)[segment];
      }
      identities.bindDraft(
        binding.kind,
        binding.handle,
        apiObject(source)['id'],
      );
    }
    final external =
        _externalDecoders.keys
            .where(
              (prefix) =>
                  operation.path == prefix ||
                  operation.path.startsWith('$prefix:') ||
                  operation.path.startsWith('$prefix/'),
            )
            .toList()
          ..sort((a, b) => b.length.compareTo(a.length));
    if (external.isNotEmpty) {
      _decodeExternalReceipt(receipt, _externalDecoders[external.first]!);
      return;
    }
    final parts = operation.path.split('/').last.split(':');
    final resource = parts.first;
    final command = parts.last;
    if (command == 'delete') {
      final data = apiObject(receipt.data);
      if (resource == 'icon-cache' || resource == 'ip-quality-cache') {
        final key = resource == 'icon-cache' ? 'deletedUrls' : 'deletedIps';
        for (final value in apiList(data[key])) {
          if (value is! String) {
            throw const WebApiProtocolException('Invalid cache delete receipt');
          }
        }
      } else {
        for (final value in apiList(data['deletedIds'])) {
          requireWireId(value, 'deletedIds');
        }
      }
      return;
    }
    switch (resource) {
      case 'profiles':
        if (command == 'reorder') {
          _decodeList(receipt.data, codec.profile);
        } else {
          codec.profile(receipt.data);
        }
      case 'rules':
        if (command == 'replace' || command == 'reorder') {
          _decodeList(receipt.data, codec.rule);
        } else {
          codec.rule(receipt.data);
        }
      case 'disabled-rules':
        _disabled(receipt.data);
      case 'proxy-dialers':
        _dialers(receipt.data);
      case 'icon-cache':
        codec.iconRecord(receipt.data);
      case 'ip-quality-cache':
        codec.ipQualityRecord(receipt.data);
      default:
        final specs = <ApiCatalog<Object>>[
          groups,
          proxies,
          scripts,
          providers,
          iconSets,
          modules,
        ];
        final spec = specs
            .where((item) => item.resource == resource)
            .firstOrNull;
        if (spec == null) {
          throw const WebApiProtocolException('Unsupported operation receipt');
        }
        if (command == 'replace' || command == 'reorder') {
          _decodeList(receipt.data, spec.decode);
        } else {
          spec.decode(receipt.data);
        }
    }
  }

  void _acceptMeta(ApiReceipt receipt) {
    final meta = apiObject(receipt.data, 'meta');
    final store = meta['storeId'];
    if (store is! String ||
        store.isEmpty ||
        meta['revision'] != receipt.revision) {
      throw const WebApiProtocolException('Invalid server store identity');
    }
    apiInteger(meta['schemaVersion'], 'meta.schemaVersion');
    _client.bindStore(store);
    if (_storeId != null && _storeId != store) {
      _cache.clear();
      identities.clear();
      _generation++;
      _blockedStore = true;
      throw const WebApiException(
        'store_changed',
        'The authoritative store was replaced; reload the session',
      );
    }
    _storeId = store;
    _client.observeRevision(receipt.revision);
  }

  List<int> _disabled(Object? value, [int? profileId]) {
    final data = apiObject(value, 'disabledRules');
    final owner = codec.id(ApiIdentity.profile, data['profileId']);
    if (profileId != null &&
        owner != identities.canonical(ApiIdentity.profile, profileId)) {
      throw const WebApiProtocolException('Mismatched disabled-rule owner');
    }
    final rows = List<int>.unmodifiable([
      for (final value in apiList(data['ruleIds']))
        codec.id(ApiIdentity.rule, value),
    ]);
    return rows;
  }

  List<ProxyDialer> _dialers(Object? value, [int? profileId]) {
    final data = apiObject(value, 'proxyDialers');
    final owner = codec.id(ApiIdentity.profile, data['profileId']);
    if (profileId != null &&
        owner != identities.canonical(ApiIdentity.profile, profileId)) {
      throw const WebApiProtocolException('Mismatched dialer owner');
    }
    return [
      for (final value in apiList(data['dialers']))
        codec.proxyDialer({
          ...apiObject(value),
          'profileId': data['profileId'],
        }),
    ];
  }

  List<Map<String, Object?>> _replacementInputs<T>(
    ApiIdentity kind,
    List<T> values,
    int Function(T) id,
    Map<String, Object?> Function(T) encode,
    List<ApiDraftBinding> drafts,
  ) {
    final seen = <int>{};
    return [
      for (final (index, value) in values.indexed)
        (() {
          final local = id(value);
          if (!seen.add(identities.canonical(kind, local))) {
            throw const WebApiProtocolException(
              'Duplicate identities in replacement',
            );
          }
          final bound = identities.isBound(kind, local);
          if (!bound) {
            identities.registerDraft(kind, local);
            drafts.add(ApiDraftBinding(kind, local, index: index));
          }
          return {if (bound) 'id': _wire(kind, local), ...encode(value)};
        })(),
    ];
  }

  String _wire(ApiIdentity kind, int id) => codec.wireId(kind, id);

  List<String> _wireIds(ApiIdentity kind, Iterable<int> ids) {
    final result = [for (final id in ids) _wire(kind, id)];
    if (result.toSet().length != result.length) {
      throw const WebApiProtocolException('Duplicate command identities');
    }
    return result;
  }

  String _catalogPath<T>(ApiCatalog<T> spec, {int? profileId}) =>
      '/api/v1/${spec.resource}${profileId == null ? '' : '?profileId=${_wire(ApiIdentity.profile, profileId)}'}';

  void _requireOwner<T>(ApiCatalog<T> spec, int? profileId) {
    if (spec.profileOwned != (profileId != null)) {
      throw ArgumentError('Invalid resource owner');
    }
  }

  String _rulesPath(int? profileId) =>
      '/api/v1/rules?scope=${profileId == null ? 'global' : 'profile'}${profileId == null ? '' : '&profileId=${_wire(ApiIdentity.profile, profileId)}'}';

  List<T> _decodeList<T>(Object? value, T Function(Object?) decode) =>
      List.unmodifiable([for (final item in apiList(value)) decode(item)]);

  void _invalidate(ApiRevisionScope scope, {bool notify = true}) {
    _generation++;
    _cache.removeWhere((key, _) => key.$2 == scope);
    if (notify) _notify();
  }

  void _notify() {
    if (_closed || _notifyQueued) return;
    _notifyQueued = true;
    scheduleMicrotask(() {
      _notifyQueued = false;
      if (!_closed) _changes.add(null);
    });
  }

  void _releaseBarrier(Completer<void> barrier) {
    if (identical(_writeBarrier, barrier)) _writeBarrier = null;
    if (!barrier.isCompleted) barrier.complete();
    _notify();
  }

  Future<T> _projectCommitted<T>(
    ApiReceipt receipt,
    Future<T> Function() read,
  ) async {
    try {
      return await read();
    } on WebApiSessionException {
      rethrow;
    } catch (_) {
      throw WebApiCommittedProjectionException(
        receipt.operationId!,
        receipt.revision,
      );
    }
  }

  Future<T> _currentRow<T>(
    ApiReceipt receipt,
    Future<List<T>> Function() read,
    int Function(T) id,
    int expectedId,
  ) => _projectCommitted(
    receipt,
    () async => (await read()).firstWhere((item) => id(item) == expectedId),
  );

  void _storeUnfoldSet(int id, Set<String> value) {
    final wire = _wire(ApiIdentity.profile, id);
    final stored = Set<String>.unmodifiable(value);
    _writeProfilePresentation?.call(_storeId!, wire, stored);
    _profileUnfolds[(_storeId!, wire)] = stored;
  }

  void _validateVersion(ApiEditVersion token) {
    if (!identical(token._issuer, _tokenIssuer)) {
      throw const WebApiException(
        'edit_issuer_mismatch',
        'The edit version belongs to another repository',
      );
    }
    _client.requireSession(token._epoch);
    _requireStore();
    if (token.storeId != _storeId) {
      throw const WebApiException(
        'edit_store_changed',
        'The edit belongs to another authoritative store',
      );
    }
    requireApiRevision(token.revision);
  }

  ApiEditVersion _rowVersion(
    ApiIdentity kind,
    int id,
    ApiEditVersion? token, {
    bool create = false,
  }) {
    if (token == null) {
      throw const WebApiException(
        'edit_baseline_required',
        'Save requires the original read version, not the latest global revision',
      );
    }
    _validateVersion(token);
    if (token.kind != kind ||
        (create
            ? token._subject != _EditSubject.create
            : token._subject != _EditSubject.row ||
                  token._wireId != _wire(kind, id))) {
      throw const WebApiException(
        'edit_baseline_mismatch',
        'The edit version belongs to another resource',
      );
    }
    return token;
  }

  void _collectionVersion(ApiIdentity kind, ApiEditVersion token, String path) {
    _validateVersion(token);
    if (token.kind != kind ||
        token._subject != _EditSubject.collection ||
        token._readPath != path) {
      throw const WebApiException(
        'edit_baseline_mismatch',
        'Replacement requires the original complete owner collection',
      );
    }
  }

  T _decodeExternalReceipt<T>(ApiReceipt receipt, T Function(Object?) decode) {
    final value = decode(receipt.data);
    if (value is! ApiCanonicalProjectionCarrier) return value;
    final projections = List<ApiCanonicalProjection>.of(
      value.canonicalProjections,
      growable: false,
    );
    if (projections.isEmpty) return value;
    _requireCanonicalMutationReceipt(receipt);
    final fingerprints = <String>[];
    for (final projection in projections) {
      final matches = switch ((projection.kind, projection.model)) {
        (ApiIdentity.profile, Profile()) ||
        (ApiIdentity.script, Script()) ||
        (ApiIdentity.clashProvider, ClashProvider()) ||
        (ApiIdentity.mitmModule, MitmModule()) => true,
        _ => false,
      };
      if (!matches ||
          !identities.isBound(projection.kind, _modelId(projection.model))) {
        throw const WebApiProtocolException(
          'Expected an already bound canonical model of the declared kind',
        );
      }
      fingerprints.add(_fingerprint(projection.model));
    }
    for (final (index, projection) in projections.indexed) {
      Object? node = receipt.data;
      for (final segment in projection.path) {
        if (segment is String && node is Map && node.containsKey(segment)) {
          node = node[segment];
        } else if (segment is int &&
            node is List &&
            segment >= 0 &&
            segment < node.length) {
          node = node[segment];
        } else {
          throw const WebApiProtocolException(
            'Canonical projection path is absent from the mutation receipt',
          );
        }
      }
      final canonical = switch (projection.kind) {
        ApiIdentity.profile => codec.profile(node),
        ApiIdentity.script => codec.script(node),
        ApiIdentity.clashProvider => codec.clashProvider(node),
        ApiIdentity.mitmModule => codec.mitmModule(node),
        _ => throw const WebApiProtocolException(
          'Unsupported canonical projection kind',
        ),
      };
      if (fingerprints[index] != _fingerprint(canonical)) {
        throw const WebApiProtocolException(
          'Canonical model does not match the original mutation receipt',
        );
      }
    }
    _requireCanonicalMutationReceipt(receipt);
    for (final projection in projections) {
      _tagRow(projection.model, projection.kind, receipt.revision);
    }
    return value;
  }

  void _requireCanonicalMutationReceipt(ApiReceipt receipt) {
    _client.requireSession(_client.sessionEpoch);
    _requireStore();
    if (!_client.ownsReceipt(receipt) ||
        _storeId == null ||
        _storeId != _client.boundStoreId ||
        _client.receiptScope(receipt) != ApiRevisionScope.configuration ||
        receipt.operationId == null) {
      throw const WebApiProtocolException(
        'Canonical models require an owned configuration mutation receipt',
      );
    }
    if (!identical(_completed[receipt.operationId], receipt)) {
      _client.requirePendingReceipt(receipt);
    }
  }

  T _tagRow<T>(T value, ApiIdentity kind, String revision, {String? readPath}) {
    if (value is! Object) {
      throw const WebApiProtocolException('Missing canonical model');
    }
    final id = _modelId(value);
    _sources[value] = ApiEditVersion._(
      issuer: _tokenIssuer,
      storeId: _storeId!,
      revision: revision,
      kind: kind,
      localId: id,
      epoch: _client.sessionEpoch,
      subject: _EditSubject.row,
      wireId: _wire(kind, id),
      fingerprint: _fingerprint(value),
      readPath: readPath,
    );
    return value;
  }

  List<T> _tagCollection<T>(
    List<T> rows,
    ApiIdentity kind,
    String revision,
    String path,
  ) {
    final ids = <int>{};
    for (final row in rows) {
      if (row is Profile ||
          row is Rule ||
          row is ProxyGroup ||
          row is CustomProxy ||
          row is Script ||
          row is ClashProvider ||
          row is IconSet ||
          row is MitmModule) {
        final id = _modelId(row as Object);
        if (!ids.add(id)) {
          throw const WebApiProtocolException(
            'Duplicate resource identity in API collection',
          );
        }
        _tagRow(row, kind, revision, readPath: path);
      }
    }
    _sources[rows] = ApiEditVersion._(
      issuer: _tokenIssuer,
      storeId: _storeId!,
      revision: revision,
      kind: kind,
      localId: null,
      epoch: _client.sessionEpoch,
      subject: _EditSubject.collection,
      fingerprint: _fingerprint(rows),
      readPath: path,
    );
    return rows;
  }

  ApiIdentity _resourceIdentity(String path) =>
      switch (Uri.parse(path).path.split('/').last) {
        'profiles' => ApiIdentity.profile,
        'rules' => ApiIdentity.rule,
        'proxy-groups' => ApiIdentity.proxyGroup,
        'custom-proxies' => ApiIdentity.customProxy,
        'scripts' => ApiIdentity.script,
        'clash-providers' => ApiIdentity.clashProvider,
        'icon-sets' => ApiIdentity.iconSet,
        'mitm-modules' => ApiIdentity.mitmModule,
        _ => throw const WebApiProtocolException('Unknown model collection'),
      };

  int _modelId(Object value) => switch (value) {
    Profile(:final id) ||
    Rule(:final id) ||
    ProxyGroup(:final id) ||
    CustomProxy(:final id) ||
    Script(:final id) ||
    ClashProvider(:final id) ||
    IconSet(:final id) ||
    MitmModule(:final id) => id,
    _ => throw const WebApiProtocolException(
      'Unknown canonical model identity',
    ),
  };

  Object? _modelDocument(Object? value) => switch (value) {
    Profile() => {
      'id': _wire(ApiIdentity.profile, value.id),
      ...codec.profileInput(value),
      'lastUpdateDate': value.lastUpdateDate?.toIso8601String(),
      'subscriptionInfo': value.subscriptionInfo?.toJson(),
      'order': value.order,
    },
    Rule() => {
      'id': _wire(ApiIdentity.rule, value.id),
      ...codec.ruleInput(value),
      'order': value.order,
    },
    ProxyGroup() => {
      'id': _wire(ApiIdentity.proxyGroup, value.id),
      'profileId': value.profileId == null
          ? null
          : _wire(ApiIdentity.profile, value.profileId!),
      ...codec.proxyGroupInput(value),
      'order': value.order,
    },
    CustomProxy() => {
      'id': _wire(ApiIdentity.customProxy, value.id),
      ...codec.customProxyInput(value),
      'order': value.order,
    },
    Script() => {
      'id': _wire(ApiIdentity.script, value.id),
      ...codec.scriptInput(value),
      'lastUpdateTime': value.lastUpdateTime.toIso8601String(),
      'order': value.order,
    },
    ClashProvider() => {
      'id': _wire(ApiIdentity.clashProvider, value.id),
      ...codec.clashProviderInput(value),
      'behavior': value.behavior.name,
      'format': value.format.name,
      'order': value.order,
    },
    IconSet() => {
      'id': _wire(ApiIdentity.iconSet, value.id),
      ...codec.iconSetInput(value),
      'lastUpdateTime': value.lastUpdateTime?.toIso8601String(),
      'order': value.order,
    },
    MitmModule() => {
      'id': _wire(ApiIdentity.mitmModule, value.id),
      ...codec.mitmModuleInput(value),
      'resources': value.resources,
      'scripts': value.scripts,
      'lastUpdateTime': value.lastUpdateTime.toIso8601String(),
      'order': value.order,
    },
    ProxyDialer() => {
      'profileId': _wire(ApiIdentity.profile, value.profileId),
      'proxyId': _wire(ApiIdentity.customProxy, value.proxyId),
      'target': value.target,
    },
    List() => [for (final item in value) _modelDocument(item)],
    Map() => {
      for (final entry in value.entries)
        entry.key.toString(): _modelDocument(entry.value),
    },
    _ => value,
  };

  String _fingerprint(Object value) => _jsonFingerprint(_modelDocument(value));

  String _jsonFingerprint(Object? value) {
    Object? ordered(Object? item) => switch (item) {
      Map() => {
        for (final key
            in item.keys.map((key) => key.toString()).toList()..sort())
          key: ordered(item[key]),
      },
      List() => [for (final child in item) ordered(child)],
      _ => item,
    };
    return sha256.convert(utf8.encode(jsonEncode(ordered(value)))).toString();
  }

  void _requireStore() {
    if (_blockedStore) {
      throw const WebApiException(
        'store_changed',
        'Reload the replaced store before continuing',
      );
    }
  }

  void _remember(ApiReceipt receipt) {
    final operationId = receipt.operationId!;
    _completed[operationId] = receipt;
    _receiptEvents.remove(operationId);
    if (_completed.length > 64) _completed.remove(_completed.keys.first);
  }

  Future<void> close() async {
    if (_closed) return;
    _closed = true;
    await _sessionSubscription.cancel();
    await _client.close();
    identities.clear();
    _cache.clear();
    _completed.clear();
    _authorizedOperations.clear();
    _preparedOperations.clear();
    _dependencyPreparations.clear();
    _dependencyGrants.clear();
    _profileUnfolds.clear();
    await _changes.close();
  }
}
