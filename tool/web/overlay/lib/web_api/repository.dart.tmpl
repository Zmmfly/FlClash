  Future<List<Rule>> replaceRules(
    int? profileId,
    List<Rule> rules, {
    required ApiEditVersion editVersion,
  }) async {
    _collectionVersion(ApiIdentity.rule, editVersion, _rulesPath(profileId));
    final drafts = <ApiDraftBinding>[];
    final inputs = _replacementInputs(
      ApiIdentity.rule,
      rules,
      (value) => value.id,
      (value) => {
        ...codec.ruleInput(value),
        'profileId': profileId == null
            ? null
            : _wire(ApiIdentity.profile, profileId),
      },
      drafts,
    );
    final receipt = await _mutate(
      '/api/v1/rules:replace',
      {
        'profileId': profileId == null
            ? null
            : _wire(ApiIdentity.profile, profileId),
        'rules': inputs,
      },
      editVersion: editVersion,
