  Future<Profile> saveProfile(
    Profile profile, {
    ApiEditVersion? editVersion,
  }) async {
    if (editVersion != null) _validateVersion(editVersion);
    final bound = identities.isBound(ApiIdentity.profile, profile.id);
    final version = _rowVersion(
      ApiIdentity.profile,
      profile.id,
      editVersion,
      create: !bound,
    );
    if (!bound) identities.registerDraft(ApiIdentity.profile, profile.id);
    final receipt = await _mutate(
      '/api/v1/profiles:${bound ? 'update' : 'create'}',
      {
        if (bound) 'id': _wire(ApiIdentity.profile, profile.id),
        'profile': codec.profileInput(profile),
      },
      editVersion: version,
      drafts: bound
          ? const []
          : [ApiDraftBinding(ApiIdentity.profile, profile.id)],
      refresh: ['/api/v1/profiles'],
    );
    final saved = codec.profile(receipt.data);
    return _currentRow(receipt, profiles().get, (item) => item.id, saved.id);
  }

  Future<Profile> setProfileUnfoldSet(int id, Set<String> unfoldSet) async {
    final profile = await profiles(id: id).getSingle();
    _storeUnfoldSet(id, unfoldSet);
    _notify();
    return profile.copyWith(unfoldSet: Set.unmodifiable(unfoldSet));
  }

  Profile _profile(Object? data) {
    final profile = codec.profile(data);
    final wire = _wire(ApiIdentity.profile, profile.id);
    return profile.copyWith(
      unfoldSet: _profileUnfolds.putIfAbsent(
        (_storeId ?? '', wire),
        () => Set.unmodifiable(
          _readProfilePresentation?.call(_storeId ?? '', wire) ?? const {},
        ),
      ),
    );
  }

