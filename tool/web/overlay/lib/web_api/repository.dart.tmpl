  Future<T> saveCatalog<T>(
    ApiCatalog<T> spec,
    T value, {
    int? profileId,
    ApiEditVersion? editVersion,
  }) async {
    _requireOwner(spec, profileId);
    if (editVersion != null) _validateVersion(editVersion);
    final id = spec.localId(value);
    final bound = identities.isBound(spec.identity, id);
    if (!bound) identities.registerDraft(spec.identity, id);
    final version = _rowVersion(spec.identity, id, editVersion, create: !bound);
    final receipt = await _mutate(
      '/api/v1/${spec.resource}:${bound ? 'update' : 'create'}',
      {
        if (profileId != null)
          'profileId': _wire(ApiIdentity.profile, profileId),
        if (bound) 'id': _wire(spec.identity, id),
        spec.singular: spec.encode(value),
      },
      editVersion: version,
      drafts: bound ? const [] : [ApiDraftBinding(spec.identity, id)],
      refresh: [_catalogPath(spec, profileId: profileId)],
    );
    return _currentRow(
      receipt,
      catalog(spec, profileId: profileId).get,
      spec.localId,
      id,
    );
  }

