  Future<MitmModule> attach(
    MitmModule original,
    String reference,
    List<int> bytes, {
    required ApiEditVersion editVersion,
  }) async {
    final result = await repository.executeExternalCommand(
      '/api/v1/mitm-modules:attach',
      {
        'id': repository.codec.wireId(ApiIdentity.mitmModule, original.id),
        'sourceReference': reference,
        'bytes': base64Encode(bytes),
      },
      decodeMutation,
      editVersion: editVersion,
    );
    final module = result.mitmModule!;
    if (result.summary.ref.kind != WebContentKind.mitmResource ||
        repository.identities.canonical(ApiIdentity.mitmModule, module.id) !=
            repository.identities.canonical(
              ApiIdentity.mitmModule,
              original.id,
            ) ||
        module.resources[reference] != result.summary.ref.name ||
        result.summary.sha256 != crypto.sha256.convert(bytes).toString() ||
        result.summary.size != bytes.length) {
      throw const WebApiProtocolException(
        'Attachment receipt changed its owner reference or bytes',
      );
    }
    return module;
  }

  Future<MitmModule> detach(
    MitmModule original,
    String reference, {
    required ApiEditVersion editVersion,
  }) async {
    final name = original.resources[reference];
    if (name == null)
      throw const WebApiException(
        'resource_missing',
        'The attachment reference is absent',
      );
    final result = await repository.executeExternalCommand(
      '/api/v1/mitm-modules:detach',
      {
        'id': repository.codec.wireId(ApiIdentity.mitmModule, original.id),
        'sourceReference': reference,
      },
      _decodeDetached,
      editVersion: editVersion,
    );
    if (repository.identities.canonical(
              ApiIdentity.mitmModule,
              result.module.id,
            ) !=
            repository.identities.canonical(
              ApiIdentity.mitmModule,
              original.id,
            ) ||
        result.key.name != name ||
        result.module.resources.containsKey(reference)) {
      throw const WebApiProtocolException(
        'Detach receipt changed its owner or reference',
      );
    }
    return result.module;
  }

  WebDetachedModuleResult _decodeDetached(Object? value) {
    final data = apiObject(value, 'module detach');
    final module = repository.codec.mitmModule(data['mitmModule']);
    final key = apiObject(data['detachedKey'], 'detached content key');
    final id = repository.codec.id(ApiIdentity.mitmModule, key['id']);
    if (key['kind'] != 'mitm-resource' ||
        id != module.id ||
        key['name'] is! String ||
        (key['name'] as String).isEmpty) {
      throw const WebApiProtocolException('Invalid detached resource identity');
    }
    return WebDetachedModuleResult(
      module,
      WebContentRef(
        WebContentKind.mitmResource,
        id,
        name: key['name'] as String,
      ),
    );
  }

  Future<MitmModule> setArguments(
    MitmModule original,
    Map<String, String> arguments, {
    required ApiEditVersion editVersion,
  }) => repository.runIntent(() async {
    final result = await _preparedCommand(
      WebContentRef(WebContentKind.mitmModule, original.id),
      '/api/v1/mitm-modules:prepare-arguments',
      '/api/v1/mitm-modules:arguments',
      {
        'id': repository.codec.wireId(ApiIdentity.mitmModule, original.id),
        'arguments': arguments,
      },
      editVersion,
    );
    return result.mitmModule!;
  });

  WebContentMutation _decodeFor(WebContentRef expected, Object? value) {
    final result = decodeMutation(value);
    if (result.summary.ref.kind != expected.kind ||
        repository.identities.canonical(
              expected.kind.identity,
              result.summary.ref.id,
            ) !=
            repository.identities.canonical(
              expected.kind.identity,
              expected.id,
            ) ||
        expected.kind != WebContentKind.mitmResource &&
            result.summary.ref.name != expected.name) {
      throw const WebApiProtocolException(
        'Content receipt names another resource',
      );
    }
    return result;
  }

  WebContentMutation decodeMutation(Object? value) {
    final data = apiObject(value, 'content mutation');
    final summary = _summary(apiObject(data['content']));
    final fields = [
      'profile',
      'script',
      'ruleProvider',
      'mitmModule',
    ].where((key) => data[key] != null).toList();
    final expected = switch (summary.ref.kind) {
      WebContentKind.profile => 'profile',
      WebContentKind.script => 'script',
      WebContentKind.ruleProvider => 'ruleProvider',
      WebContentKind.mitmModule || WebContentKind.mitmResource => 'mitmModule',
    };
    if (fields.length != 1 || fields.single != expected) {
      throw const WebApiProtocolException('Mismatched content owner receipt');
    }
    final profile = data['profile'] == null
        ? null
        : repository.codec.profile(data['profile']);
    final script = data['script'] == null
        ? null
        : repository.codec.script(data['script']);
    final provider = data['ruleProvider'] == null
        ? null
        : repository.codec.clashProvider(data['ruleProvider']);
    final module = data['mitmModule'] == null
        ? null
        : repository.codec.mitmModule(data['mitmModule']);
    final owner = profile?.id ?? script?.id ?? provider?.id ?? module?.id;
    if (owner != summary.ref.id)
      throw const WebApiProtocolException(
        'Mismatched content identity receipt',
      );
    return WebContentMutation(
      summary: summary,
      profile: profile,
      script: script,
      ruleProvider: provider,
      mitmModule: module,
    );
  }

  Map<String, Object?> _key(WebContentRef ref) => {
    'kind': ref.kind.wireName,
    'id': ref.wireId(repository),
    if (ref.name != null) 'name': ref.name,
  };

  WebContentSummary _summary(
    Map<String, Object?> data, {
    WebContentRef? expected,
  }) {
    final key = apiObject(data['key'], 'content.key');
    final kind = WebContentKind.values
        .where((item) => item.wireName == key['kind'])
        .firstOrNull;
    if (kind == null)
      throw const WebApiProtocolException('Unknown content kind');
    final id = repository.codec.id(kind.identity, key['id'], 'content.key.id');
    final name = key['name'];
    if (name != null && name is! String ||
        kind == WebContentKind.mitmResource && name == null) {
      throw const WebApiProtocolException('Invalid content resource key');
    }
    final ref = WebContentRef(kind, id, name: name as String?);
    if (expected != null &&
        (kind != expected.kind || id != expected.id || name != expected.name)) {
      throw const WebApiProtocolException('Mismatched resource content');
    }
    final mediaType = data['mediaType'];
    final digest = data['sha256'];
    final size = apiInteger(data['size'], 'content.size');
    if (size < 0 ||
        size > 32 * 1024 * 1024 ||
        mediaType is! String ||
        digest is! String ||
        !RegExp(r'^[0-9a-f]{64}$').hasMatch(digest)) {
      throw const WebApiProtocolException('Invalid content summary');
    }
    final modified = data['modifiedAt'];
    final modifiedAt = modified == null || modified == ''
        ? null
        : modified is String
        ? DateTime.tryParse(modified)
        : null;
    if (modified != null && modified != '' && modifiedAt == null)
      throw const WebApiProtocolException('Invalid content modification time');
    return WebContentSummary(
      ref: ref,
      modifiedAt: modifiedAt,
      mediaType: mediaType,
      sha256: digest,
      size: size,
    );
  }

  Uint8List _bytes(Object? value) {
    if (value is! String || value.length > ((32 * 1024 * 1024 + 2) ~/ 3) * 4)
      throw const WebApiProtocolException('Invalid encoded content');
    try {
      return base64Decode(value);
    } on FormatException {
      throw const WebApiProtocolException('Invalid encoded content');
    }
  }
}
