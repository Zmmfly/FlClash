void registerWebWorkflowReceipts(WebApiRepository repository) {
  WebContentWorkflows(repository);
  WebBackupWorkflows(repository);
  WebIconSetWorkflows(repository);
  WebSourceWorkflows(repository);
  WebDavWorkflows(repository);
}

final _externalProviderWorkflows = Expando<WebExternalProviderWorkflows>(
  'web-provider-workflows',
);

WebExternalProviderWorkflows webExternalProviderWorkflows(
  WebApiRepository repository,
) => _externalProviderWorkflows[repository] ??= WebExternalProviderWorkflows(
  repository,
  confirmSource: showWebSourceConsent,
);
