class ProxyDialersDao {
  const ProxyDialersDao(this.repository);
  final WebApiRepository repository;

  ApiQuery<ProxyDialer> query(int profileId) => repository.dialers(profileId);
  Future<void> setAll(
    int profileId,
    Map<int, String> dialers, {
    required ApiEditVersion editVersion,
  }) => repository.replaceDialers(profileId, dialers, editVersion: editVersion);

  Future<void> set(int profileId, int proxyId, String? target) =>
      repository.runIntent(() async {
        final rows = await query(profileId).get();
        final version = repository.captureEditVersion(
          ApiIdentity.profile,
          rows,
        );
        final current = {for (final item in rows) item.proxyId: item.target};
        if (target == null) {
          current.remove(proxyId);
        } else {
          current[proxyId] = target;
        }
        await setAll(profileId, current, editVersion: version);
      });

  Future<Map<int, Set<String>>> targetsNaming(Set<String> names) async {
    final result = <int, Set<String>>{};
    for (final profile in await repository.profiles().get()) {
      if (profile.type != ProfileType.custom) continue;
      for (final dialer in await query(profile.id).get()) {
        if (names.contains(dialer.target)) {
          result.putIfAbsent(profile.id, () => {}).add(dialer.target);
        }
      }
    }
    return result;
  }
}

class IconRecordsDao {
  const IconRecordsDao(this.repository);
  final WebApiRepository repository;
  int get maxCapacity => 1000;

  Future<IconRecord?> get(String url) async {
    final rows = await repository.iconRecords(url: url);
    if (rows.isEmpty) return null;
    if (rows.length != 1) throw StateError('Duplicate icon cache entry');
    return repository.putIcon(url, touch: true);
  }

  Future<void> put(String url) async {
    await repository.putIcon(url);
  }

  Future<void> del(String url) => repository.deleteIcons([url]);
  Future<List<IconRecord>> query(String query) =>
      repository.iconRecords(query: query);
}

class IpQualitiesDao {
  const IpQualitiesDao(this.repository);
  final WebApiRepository repository;

  Future<IpQualityRecord?> fresh(String ip, Duration maxAge) =>
      repository.freshIpQuality(ip, maxAge);
  Future<void> put(
    IpQuality quality,
    DateTime checkedAt,
    Duration maxAge,
  ) async {
    await repository.putIpQuality(quality);
  }
}

Database _database = Database();
Database get database => _database;
set database(Database value) => _database = value;
