import 'dart:js_interop';
import 'dart:typed_data';

import 'package:rust_api/dart_io.dart' as io;
import 'package:rust_api/vfs.dart';

// WEBPANEL.md: Web keeps only ephemeral /tmp and /downloads; every persistent
// resource is owned by its typed API and a file path reaching it must fail.
@JS('window.__vfsTestReport')
external void _report(JSString message);

void expect(bool condition, String message) {
  if (!condition) throw StateError(message);
}

void expectFailure(void Function() operation, String message) {
  var failed = false;
  try {
    operation();
  } catch (_) {
    failed = true;
  }
  expect(failed, message);
}

Future<void> main() async {
  try {
    await _run();
    _report('pass'.toJS);
  } catch (error, stack) {
    _report('fail: $error\n$stack'.toJS);
  }
}

Future<void> _run() async {
  final fs = WebFileSystem.instance;
  for (final directory in const [
    '/',
    '/data',
    '/data/profiles',
    '/data/providers',
    '/tmp',
    '/downloads',
  ]) {
    expect(fs.isDirectory(directory), 'Fixed directory missing: $directory');
  }
  for (final path in const [
    '/run/systemd/system',
    '/etc/passwd',
    '/proc/self/status',
    '/sys/class/net',
    '/data/../../run/systemd/system',
  ]) {
    expect(!fs.exists(path), 'Host path must not exist: $path');
  }
  expect(
    !io.Directory('/run/systemd/system').existsSync(),
    'The browser must not advertise the native Linux helper',
  );
  expectFailure(
    () => fs.normalize('/tmp/a\u0000b'),
    'NUL path must be rejected',
  );

  for (final operation in <void Function()>[
    () => fs.writeBytes('/data/database.sqlite', [1]),
    () => fs.writeBytes('/data/profiles/1.yaml', [1]),
    () => fs.writeBytes('relative.txt', [1]),
    () => fs.writeBytes('/run/escape', [1]),
    () => fs.mkdir('/data/cache'),
    () => fs.mkdir('/data/profiles/nested'),
    () => fs.readBytes('/data/existing'),
    () => fs.delete('/data/profiles'),
    () => fs.rename('/tmp/absent', '/data/moved'),
    () => fs.copy('/data/existing', '/tmp/copied'),
    () => io.File('/data/database.sqlite').createSync(),
    () => io.File('/etc/passwd').writeAsStringSync('x'),
    () => io.Directory('/data/cache').createSync(recursive: true),
    () => io.File('/data/existing').readAsBytesSync(),
  ]) {
    expectFailure(operation, 'Persistent resource operation must fail');
  }
  expectFailure(
    () => fs.stat('/data/cache'),
    'A failed persistent mkdir must not become addressable',
  );
  expectFailure(
    () => fs.stat('/data/database.sqlite'),
    'A failed persistent write must not become addressable',
  );
  expectFailure(
    () => fs.stat('relative.txt'),
    'A relative path must not fall back to /tmp',
  );
  expect(
    fs.isDirectory('/data/profiles'),
    'A failed persistent delete must keep the fixed directory',
  );

  final file = io.File('/tmp/a.txt');
  file.writeAsStringSync('hello');
  expect(file.existsSync(), 'An ephemeral write must create the file');
  expect(file.readAsStringSync() == 'hello', 'Ephemeral read-back must match');
  expect(file.lengthSync() == 5, 'Ephemeral length must match');
  file.writeAsBytesSync([33], mode: io.FileMode.append);
  expect(file.readAsStringSync() == 'hello!', 'Append must extend the buffer');
  expect(
    io.File('/tmp/missing.txt').existsSync() == false,
    'Missing ephemeral file must not exist',
  );

  final copy = file.copySync('/tmp/b.txt');
  expect(copy.readAsStringSync() == 'hello!', 'Copy must preserve contents');
  final renamed = copy.renameSync('/tmp/c.txt');
  expect(
    renamed.readAsStringSync() == 'hello!',
    'Rename must preserve contents',
  );
  expect(!io.File('/tmp/b.txt').existsSync(), 'Rename must remove the source');
  final chunk = await renamed.openRead(0, 3).first;
  expect(
    String.fromCharCodes(chunk) == 'hel',
    'openRead must honour start and end',
  );

  final randomAccess = io.File(
    '/tmp/raf.txt',
  ).openSync(mode: io.FileMode.write);
  randomAccess.writeStringSync('abc');
  randomAccess.setPositionSync(1);
  randomAccess.writeStringSync('Z');
  randomAccess.flushSync();
  randomAccess.closeSync();
  expect(
    io.File('/tmp/raf.txt').readAsStringSync() == 'aZc',
    'Random access writes must land',
  );

  final work = io.Directory('/tmp/work/deep');
  work.createSync(recursive: true);
  io.File('/tmp/work/deep/one.bin').writeAsBytesSync([1, 2]);
  io.File('/tmp/work/two.bin').writeAsBytesSync([3]);
  expect(
    io.Directory('/tmp/work').listSync().length == 2,
    'Shallow listing must show children',
  );
  expect(
    io.Directory('/tmp/work').listSync(recursive: true).length == 3,
    'Recursive listing must descend',
  );
  expectFailure(
    () => io.Directory('/tmp/work').deleteSync(),
    'A non-empty ephemeral directory must not be deleted without recursive',
  );
  io.Directory('/tmp/work').deleteSync(recursive: true);
  expect(
    !io.Directory('/tmp/work').existsSync(),
    'Recursive delete must remove the tree',
  );
  expectFailure(
    () => io.Directory('/tmp/work/missing').createSync(),
    'A missing ephemeral parent must not be created without recursive',
  );

  io.File('/tmp/report.bin').writeAsBytesSync([7, 8, 9]);
  io.File('/tmp/report.bin').renameSync('/downloads/report.bin');
  expect(
    io.File('/downloads/report.bin').readAsBytesSync().join(',') == '7,8,9',
    'A download buffer must stay readable after rename',
  );

  expectFailure(
    () => fs.writeBytes('/tmp/too-big', Uint8List(32 * 1024 * 1024 + 1)),
    'A temporary buffer above 32 MiB must be rejected',
  );
  final exact = Uint8List(32 * 1024 * 1024);
  fs.writeBytes('/tmp/exact', exact);
  expect(
    io.File('/tmp/exact').lengthSync() == 32 * 1024 * 1024,
    'Exactly 32 MiB must be allowed',
  );
  fs.delete('/tmp/exact');

  expectFailure(
    () => fs.mkdir('/tmp/${List.filled(2100, 'd').join('/')}', recursive: true),
    'The 2048-node budget must be enforced',
  );
  fs.mkdir('/tmp/after-budget', recursive: true);
  expect(
    fs.isDirectory('/tmp/after-budget'),
    'A failed budget must not poison later writes',
  );
  for (final name in const ['a.txt', 'c.txt', 'raf.txt']) {
    io.File('/tmp/$name').deleteSync();
  }
  io.File('/downloads/report.bin').deleteSync();

  for (final name in const ['m1', 'm2', 'm3']) {
    fs.writeBytes('/tmp/$name', exact);
  }
  expectFailure(
    () => fs.writeBytes('/tmp/m4', [1]),
    'The 96 MiB total budget must be enforced',
  );
  fs.delete('/tmp/m1');
  fs.writeBytes('/tmp/m4', [1]);
  expect(fs.exists('/tmp/m4'), 'Releasing memory must allow a later write');
  for (final name in const ['m2', 'm3', 'm4']) {
    fs.delete('/tmp/$name');
  }

  final interfaces = await io.NetworkInterface.list();
  expect(
    interfaces.isNotEmpty,
    'The typed network-interface resource must answer',
  );
  expect(
    interfaces.first.name == 'eth0',
    'The typed network-interface resource must be decoded',
  );
}
