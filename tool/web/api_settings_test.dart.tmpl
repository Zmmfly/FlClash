      final mutations = <void Function(Map<String, Object?>)>[
        (data) {
          final runtime = data['runtime'] as Map<String, Object?>;
          (runtime['appSetting'] as Map<String, Object?>)['requestFeed'] =
              'private-invalid-enum';
        },
        (data) =>
            (((data['runtime'] as Map<String, Object?>)['patchClashConfig']
                        as Map<String, Object?>)['dns']
                    as Map<String, Object?>)['cache-algorithm'] =
                'private-invalid-enum',
        (data) =>
            ((data['runtime'] as Map<String, Object?>)['patchClashConfig']
                as Map<String, Object?>)['dns-override-keys'] = [
              'private-invalid-enum',
            ],
        (data) =>
            ((data['runtime'] as Map<String, Object?>)['patchClashConfig']
                as Map<String, Object?>)['general-override-keys'] = [
