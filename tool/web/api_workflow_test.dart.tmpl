class _Transport implements ApiTransport {
  final requests = <ApiRequest>[];
  var sent = Completer<ApiRequest>();
  var response = Completer<ApiResponse>();
  ApiResponse? recovery;
  String revision = '0';
  final stored = <Map<String, Object?>>[];

  @override
  Future<ApiResponse> send(ApiRequest request) async {
    requests.add(request);
    if (request.path == '/api/v1/meta') {
      return _reply({
        'storeId': 'fixture-store',
        'schemaVersion': 23,
        'revision': revision,
      }, revision: revision);
    }
    if (request.method == 'GET' &&
        Uri.parse(request.path).path == '/api/v1/profiles') {
      return _reply(stored, revision: revision);
    }
    if (request.path.startsWith('/api/v1/operations/') && recovery != null)
      return recovery!;
    if (request.path.startsWith('/api/v1/content/profile/')) {
      final bytes = utf8.encode('proxies: []');
      return _reply({
        'key': {'kind': 'profile', 'id': request.path.split('/').last},
        'mediaType': 'application/yaml',
        'sha256': crypto.sha256.convert(bytes).toString(),
        'size': bytes.length,
        'bytes': base64Encode(bytes),
        'encrypted': false,
      }, revision: revision);
    }
    if (!sent.isCompleted) sent.complete(request);
    return response.future;
  }

  @override
  void close() {}
}

ApiResponse _reply(
  Object? data, {
  String revision = '0',
  String? operationId,
}) => ApiResponse(
  200,
  jsonEncode({
    'revision': revision,
    if (operationId != null) 'operationId': operationId,
    'data': data,
  }),
);

Map<String, Object?> _profile(Map<String, Object?> input, String id) => {
  ...input,
  'id': id,
};

class _BackupTransport extends _Transport implements ApiAttachmentTransport {
  bool rejectSchema = false;
  final archive = Uint8List.fromList([0x50, 0x4b, 0x03, 0x04, 1, 2, 3]);

  @override
  Future<ApiBinaryResponse> readAttachment(
    ApiRequest request, {
    required int maxBytes,
  }) async {
    requests.add(request);
    return ApiBinaryResponse(
      200,
      archive,
      headers: {
        'x-flclash-revision': revision,
        'content-type': 'application/zip',
        'content-length': archive.length.toString(),
        'content-disposition': 'attachment; filename="backup.zip"',
      },
    );
  }

  @override
  Future<ApiResponse> send(ApiRequest request) {
    if (request.path == '/api/v1/backups:prepare') {
      requests.add(request);
      if (rejectSchema)
        return Future.value(
          ApiResponse(
            400,
            jsonEncode({
              'revision': revision,
              'error': {
                'code': 'unsupported_backup_schema',
                'message': 'Unknown native schema',
              },
            }),
          ),
        );
      return Future.value(
        _reply({
          'token': 'session-bound-preview',
          'expiresAt': DateTime.now()
              .add(const Duration(minutes: 3))
              .toIso8601String(),
          'archiveDigest': List.filled(64, 'a').join(),
          'planDigest': List.filled(64, 'b').join(),
          'changes': [
            {
              'kind': 'profile',
              'id': '9223372036854775807',
              'name': 'legacy profile',
              'count': 2,
              'action': 'rename',
              'settingsChange': {
                'sourceField': 'legacy.stack',
                'targetField': 'runtime.patchClashConfig.tun.stack',
                'action': 'convert',
                'before': 'system',
                'after': 'mips',
                'lossless': false,
                'requiresConfirmation': true,
              },
            },
          ],
          'requiresConfirmation': true,
        }, revision: revision),
      );
    }
    return super.send(request);
  }
}

