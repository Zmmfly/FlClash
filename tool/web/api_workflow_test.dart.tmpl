                );
                oldReleased = true;
              });
            },
            child: const Text('Private setup continuation fixture'),
          ),
        ),
      );
      await tester.tap(find.text('Private setup continuation fixture'));
      await tester.pumpAndSettle();
      expect(retryRan, isFalse);
      expect(oldReleased, isFalse);
      await tester.tap(find.text('Server network access'));
      await tester.pumpAndSettle();
      await original;
      expect(oldReleased, isTrue);
      expect(retryRan, isTrue);
      expect(find.byType(WebWorkflowFailureDialog), findsNothing);
    },
  );
}
