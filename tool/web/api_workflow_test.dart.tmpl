class _DavTransport extends _SourceTransport {
  _DavTransport({this.preexistingUnknown = false}) {
    private = false;
    if (preexistingUnknown)
      jobs['previous-upload'] = _job(
        'previous-upload',
        'backup',
        'unknown',
        '0',
      );
  }
  final bool preexistingUnknown;
  bool unknownUpload = true;
  final jobs = <String, Map<String, Object?>>{};

  Map<String, Object?> _job(
    String id,
    String action,
    String phase,
    String desired, {
    String? target,
  }) => {
    'operationId': id,
    'desiredRevision': desired,
    'action': action,
    'phase': phase,
    'stage': phase,
    'updatedAt': DateTime.now().toUtc().toIso8601String(),
    if (phase == 'succeeded')
      'result': {
        'conditional': false,
        'archiveDigest': List.filled(64, 'c').join(),
        'archiveSize': 7,
        if (target != null) 'reconciliationOf': target,
        if (target != null) 'remoteMatches': true,
      },
  };

  @override
  Future<ApiResponse> send(ApiRequest request) {
    if (request.path == '/api/v1/settings') {
      requests.add(request);
      return Future.value(
        _reply({
          ..._workflowSettings(),
          'dav': {
            'uri': 'https://dav.invalid/secret-collection',
            'user': 'fixture-user',
            'password': 'fixture-dav-password-secret',
            'fileName': 'fixture.zip',
          },
        }, revision: revision),
      );
    }
    if (request.path == '/api/v1/dav/jobs') {
      requests.add(request);
      return Future.value(
        _reply([
          for (final job in jobs.values)
            {
              'operationId': job['operationId'],
              'action': job['action'],
              'phase': job['phase'],
              'stage': job['stage'],
              'updatedAt': job['updatedAt'],
              'currentTupleMatches': true,
              'needsPrepare':
                  preexistingUnknown && job['operationId'] == 'previous-upload',
            },
        ], revision: revision),
      );
    }
    if (request.method == 'POST' &&
        (request.path == '/api/v1/dav:backup' ||
            request.path.endsWith(':reconcile'))) {
      requests.add(request);
      final body = apiObject(jsonDecode(request.body!));
      final id = body['operationId'] as String;
      final action = request.path.endsWith(':reconcile')
          ? 'reconcile'
          : 'backup';
      final target = action == 'reconcile'
          ? request.path.split('/').last.replaceFirst(':reconcile', '')
          : null;
      if (body['expectedRevision'] != revision)
        return Future.value(
          ApiResponse(
            409,
            jsonEncode({
              'revision': revision,
              'error': {'code': 'revision_conflict', 'message': 'changed'},
            }),
          ),
        );
      revision = (BigInt.parse(revision) + BigInt.one).toString();
      final accepted = _job(id, action, 'pending', revision);
      jobs[id] = _job(
        id,
        action,
        action == 'backup' && unknownUpload ? 'unknown' : 'succeeded',
        revision,
        target: target,
      );
      return Future.value(
        _reply(accepted, revision: revision, operationId: id),
      );
    }
    if (request.method == 'GET' &&
        request.path.startsWith('/api/v1/dav/jobs/')) {
      requests.add(request);
      final id = request.path.split('/').last;
      if (preexistingUnknown && id == 'previous-upload')
        return Future.value(
          ApiResponse(
            403,
            jsonEncode({
              'revision': revision,
              'error': {
                'code': 'dav_session_mismatch',
                'message': 'old full job stays private',
              },
            }),
          ),
        );
      return Future.value(_reply(jobs[id], revision: revision));
    }
    return super.send(request);
  }
}

class _PreparedTransport extends _Transport {
  bool expired = false;
  Map<String, Object?>? prepared;
  var chunkSequence = 0;
  final module = <String, Object?>{
    'id': '9223372036854775807',
    'name': 'Original module',
    'description': '',
    'url': null,
    'enabled': true,
    'order': 0,
    'arguments': <String, String>{},
    'resources': <String, String>{},
    'system': null,
    'scripts': 0,
    'lastUpdateTime': '2026-01-01T00:00:00Z',
  };
  @override
  Future<ApiResponse> send(ApiRequest request) {
    if (request.method == 'GET' && request.path == '/api/v1/mitm-modules') {
      requests.add(request);
      return Future.value(_reply([module], revision: revision));
    }
    if (request.path == '/api/v1/content:prepare-write' ||
        request.path == '/api/v1/mitm-modules:prepare-import') {
      requests.add(request);
      final input = apiObject(jsonDecode(request.body!));
      final bytes = base64Decode(
        (input['bytes'] ?? apiObject(input['source'])['bytes']) as String,
      );
      prepared = {
        'preparedJobId': 'prepared-module-operation',
        'operationId': 'prepared-module-operation',
        'requestDigest': List.filled(64, 'a').join(),
        'contentSha256': crypto.sha256.convert(bytes).toString(),
        'expiresAt': DateTime.now()
            .add(Duration(minutes: expired ? -1 : 4))
            .toUtc()
            .toIso8601String(),
        'dependencies': <Object?>[],
        'attachmentReferences': ['first.js', 'second.json'],
      };
      return Future.value(_reply(prepared, revision: revision));
    }
    if (request.path ==
        '/api/v1/content-preparations/prepared-module-operation/attachments') {
      requests.add(request);
      final input = apiObject(jsonDecode(request.body!));
      if (input['requestDigest'] != prepared!['requestDigest'])
        throw StateError('stale fixture chunk digest');
      chunkSequence++;
      prepared = {
        ...prepared!,
        'requestDigest': List.filled(64, chunkSequence == 1 ? 'b' : 'c').join(),
      };
      return Future.value(_reply(prepared, revision: revision));
    }
    return super.send(request);
  }

  Map<String, Object?> receipt(String content) => {
    'content': {
      'key': {'kind': 'mitm-module', 'id': module['id']},
      'mediaType': 'text/plain',
      'sha256': crypto.sha256.convert(utf8.encode(content)).toString(),
      'size': utf8.encode(content).length,
    },
    'mitmModule': module,
  };
}

class _MetadataTransport extends _SourceTransport {
  _MetadataTransport() {
    private = false;
  }
  bool unknownCounts = false;
  bool missingGeo = false;
  Map<String, Object?>? effect;
  List<Map<String, Object?>> get geo => [
    for (final (index, type) in GeoResource.values.indexed)
      if (!missingGeo || index != GeoResource.values.length - 1)
        {
          'type': type.name,
          'updating': false,
          'sourceId': ((BigInt.one << 255) + BigInt.from(index)).toString(),
          'available': index == 0,
          'size': index == 0 ? 123 : null,
          'modifiedAt': index == 0 ? '2026-01-02T03:04:05Z' : null,
        },
  ];
  @override
  Future<ApiResponse> send(ApiRequest request) {
    if (request.path == '/api/v1/runtime/applied-counts') {
      requests.add(request);
      if (unknownCounts)
        return Future.value(
          ApiResponse(
            409,
            jsonEncode({
              'revision': revision,
              'error': {
                'code': 'runtime_unknown',
                'message': 'no actual counts proof',
              },
            }),
          ),
        );
      return Future.value(
        _reply({
          'runtimeGeneration': '2',
          'actualConfig': 'candidate',
          'groups': 2,
          'proxies': 3,
          'rules': 4,
        }, revision: revision),
      );
    }
    if (request.path == '/api/v1/runtime/geo') {
      requests.add(request);
      return Future.value(_reply(geo, revision: revision));
    }
    if (request.path == '/api/v1/runtime/geo:update') {
      requests.add(request);
      final body = apiObject(jsonDecode(request.body!));
      revision = (BigInt.parse(revision) + BigInt.one).toString();
      final accepted = <String, Object?>{
        'operationId': body['operationId'],
        'desiredRevision': revision,
        'action': 'geo-update',
        'phase': 'pending',
        'updatedAt': DateTime.now().toIso8601String(),
      };
      effect = {
        ...accepted,
        'phase': 'applied',
        'result': {
          'type': body['type'],
          'sourceId': body['sourceId'],
          'installed': true,
        },
      };
      return Future.value(
        _reply(
          accepted,
          revision: revision,
          operationId: body['operationId'] as String,
        ),
      );
    }
    if (request.path.startsWith('/api/v1/runtime/operations/')) {
      requests.add(request);
      return Future.value(_reply(effect, revision: revision));
    }
    return super.send(request);
  }
}

