          'key': {'kind': 'external-provider', 'id': providerId},
          'expiresAt': DateTime.now()
              .toUtc()
              .add(const Duration(minutes: 4))
              .toIso8601String(),
          'networkView': 'server',
          'scheme': 'https',
          'host': 'source.invalid',
          'port': 443,
          'addresses': [privateSource ? '10.0.0.8' : '8.8.8.8'],
          'requiresPrivateNetworkConfirmation': privateSource,
        }, revision: revision),
      );
    }
    if (request.path == '/api/v1/runtime/provider-sources:refresh') {
      requests.add(request);
      final body = apiObject(jsonDecode(request.body!));
      if (body['expectedRevision'] != revision)
        throw StateError('Stale source preparation revision');
      revision = (BigInt.parse(revision) + BigInt.one).toString();
      ready = true;
      final accepted = {
        'operationId': body['operationId'],
        'desiredRevision': revision,
        'action': 'refresh-provider-source',
        'phase': 'pending',
        'updatedAt': DateTime.now().toUtc().toIso8601String(),
      };
      effect = {
        ...accepted,
        'phase': 'applied',
        'result': {
          'id': providerId,
          'sourceVersion': List.filled(64, 'd').join(),
          'prepared': true,
          'requiresApply': true,
        },
      };
      return Future.value(
        _reply(
          accepted,
          revision: revision,
          operationId: body['operationId'] as String,
        ),
      );
    }
    if (request.path.startsWith('/api/v1/runtime/operations/')) {
      requests.add(request);
      return Future.value(_reply(effect, revision: revision));
    }
    return super.send(request);
  }
}

class _NoApplySetupAction extends SetupAction {
  int exits = 0;

  @override
  void build() {}

  @override
  void autoApplyProfile() => exits++;
}

